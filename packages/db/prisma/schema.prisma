model ManagementFeeConfig {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  ownerPartyId     String    @db.Uuid // owner is per-unit via Listing.ownerPartyId (resolution moved off LandlordTenancy.landlordId)
  propertyId       String?   @db.Uuid // null = all the owner's properties — plain column
  apartmentId      String?   @db.Uuid // null = property/owner default; non-null = this physical unit overrides both
  feeType          String // "percent" | "fixed" | "cap"
  feeValue         Decimal   @db.Decimal(10, 2)
  capAmount        Decimal?  @db.Decimal(10, 2)
  sstPercent       Decimal   @default(8.00) @db.Decimal(5, 2)
  freePeriodStart  DateTime?
  freePeriodEnd    DateTime?
  /// Optional operator override for the first month in which this agreement may
  /// charge a management fee.  Null means the system derives it from tenancy,
  /// free-period and first-full-month commission rules.
  firstChargeMonth DateTime? @db.Date
  /// Optional PRE-SST management-fee amount used only in firstChargeMonth.
  /// This supports negotiated/prorated first charges without changing the
  /// normal percentage/fixed/cap rule used by later months.
  firstChargeBaseAmount Decimal? @db.Decimal(10, 2)
  /// Optional rental-base deduction per occupant before the configured fee
  /// percentage/cap is applied. Null means no pax deduction. This belongs to
  /// the fee rule and may differ by owner/property/unit.
  paxDeductionPerPerson Decimal? @db.Decimal(10, 2)
  /// ⛔ DEPRECATED 2026-08-17 — ORPHANED, read and written by NOTHING. The owner-settings
  /// cleaning auto-bill field, its manual create/patch/void endpoints and the statement
  /// issuer that consumed it are all gone; the bills grid is the single cleaning issuer
  /// (bearer in the unit Setting drawer, amount in the Recurring editor). Its `@default(100)`
  /// was dropped in the same migration so no new row carries a phantom RM 100.
  /// The COLUMN is retained deliberately: a DROP COLUMN applied before the API ships would
  /// 500 the old code still reading it, and prod migrations here are manual and unordered
  /// against the code deploy. Drop it in a follow-up once this change is live everywhere.
  /// Do NOT re-wire it — reintroducing a second cleaning issuer is the exact bug that was
  /// removed in two halves (2026-07-29 automatic, 2026-08-17 manual).
  cleaningAutoBill Decimal?  @db.Decimal(10, 2)
  isActive         Boolean   @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerParty   Party        @relation("MgmtFeeOwner", fields: [ownerPartyId], references: [id], onDelete: Cascade)

  @@index([organizationId, ownerPartyId])
  @@index([organizationId, apartmentId])
}

/// Amount-only attribution of a shared purchase to a unit. This deliberately
