model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  paymentNumber     String
  partyId           String    @db.Uuid
  paymentType       String
  paymentMethod     String
  status            String
  amount            Decimal   @db.Decimal(12, 2)
  currency          String
  receivedAt        DateTime
  referenceNote     String?
  externalReference String?
  // Phase-2 (M4 FPX reconciliation + M3 retry-dedupe) — nullable, no backfill
  provider          String?
  providerTxnId     String?
  // The GATEWAY's own transaction id (Fiuu `tranID`), stamped from the first
  // callback/return that carries it. `providerTxnId` above is OUR order id.
  // Both are kept: Fiuu's status-requery retention is 7 days by order id but
  // 180 days by transaction id, and the FPX merchant agreement gives payers 60
  // days to reclaim funds — so only this column can cover a late dispute.
  providerTranId    String?
  bankCode          String?
  gatewayStatus     String?
  idempotencyKey    String?
  // transfer-slip / proof-of-payment uploads — Yannie's fraud-check artifact (minutes 2B.2)
  attachmentKeys    String[]  @default([])
  // Slip verification (tenant-submitted bank transfers). A tenant submits a
  // payment + slip as `pending_approval`; an admin either posts it (status
  // "posted") or refuses it (status "rejected"). These three are stamped ONLY
  // by the refusal path — `rejectionReason` is tenant-VISIBLE (it is shown back
  // to them so they can re-submit), unlike `referenceNote`, which is internal.
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedById      String?   @db.Uuid // User.id — plain column, no relation
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party             Party                   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  allocations       PaymentAllocation[]
  renovationOffsets RenovationClaimOffset[]
  creditApplication CreditApplication?
  refunds           Refund[]

  @@unique([organizationId, paymentNumber])
  // Postgres: NULLs distinct — multiple NULL idempotencyKeys allowed
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, partyId, receivedAt(sort: Desc)])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, provider, providerTxnId])
}

model PaymentAllocation {
