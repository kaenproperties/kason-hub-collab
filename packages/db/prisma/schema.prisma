model Deposit {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  tenancyId      String    @db.Uuid
  partyId        String    @db.Uuid
  unitId         String    @db.Uuid
  type           String
  amount         Decimal   @db.Decimal(12, 2)
  // KAEN never retains tenancy deposits. Every collected amount is payable to
  // the unit owner, including partial collections.
  status         String    @default("released_to_owner")
  refundedAmount Decimal   @default(0) @db.Decimal(12, 2)
  refundDate     DateTime?
  refundNotes    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancy      Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  party        Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  // Restrict: deposit history is financial data and must not be silently
  // destroyed when a Unit is deleted. Application code blocks Unit
  // deletion if any Deposit row exists; this is the safety net.
  unit         Listing      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, tenancyId])
  @@index([organizationId, partyId])
  @@index([unitId])
}

// ── Accounting documents P1 (spec 2026-07-02 §4.1) ───────────────────────────
// ChargeCategory — the admin-maintained charge registry (meeting D2). `code` is
// the stable machine key auto-post flows resolve by; `name` is renameable
// display. `family` drives posting class + document routing; `ledgerCategory`
// maps INTO the existing OWNER_LEDGER_CATEGORIES vocabulary for sync projection
// (it does NOT replace the EntryFormDrawer's own dropdown — spec §4.8).
model ChargeCategory {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  code             String
  name             String
  family           String // "tenant_income" | "owner_income" | "pay_back_landlord"
  docType          String // "invoice" | "debit_note" (CN/RN are never category-routed)
  seriesId         String   @db.Uuid
  defaultSstRate   Decimal  @default(0) @db.Decimal(5, 2)
  eInvoiceEligible Boolean  @default(false)
  ledgerCategory   String? // OWNER_LEDGER_CATEGORIES value, sync projection only
  isSystem         Boolean  @default(false)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  description      String?
  profitExpense    String? // "profit" | "expense" — bills-grid classification only; NOT read by issuance
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series       DocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  charges      Charge[]
  gridExpenses GridExpense[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, active, sortOrder])
  @@index([seriesId])
}

// DocumentSeries — editable numbering config per series (IVTEN/IVOWN/DEP/CN/RN).
// Counters are NOT stored here: Plan 2's mintDocumentNumberTx reuses the
// existing ReferenceSequence with docType = 'series:' + code (no new engine).
model DocumentSeries {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String
  prefix         String
  padding        Int      @default(4)
  includeYear    Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   ChargeCategory[]

  @@unique([organizationId, code])
}

/// Duplicate-charge prevention (Spec 2 R1): two PARTIAL UNIQUE INDEXes —
/// (unitId|carparkId, categoryId, billingMonth, amount) WHERE status NOT IN
/// ('void','credited') AND categoryId IS NOT NULL — live only in migration
/// 20260706120000_charge_duplicate_prevention (Prisma 7 can't express partial @@unique).
model Charge {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String    @db.Uuid
  chargeNumber                 String
  tenancyId                    String?   @db.Uuid
  unitId                       String?   @db.Uuid
  carparkId                    String?   @db.Uuid
  categoryId                   String?   @db.Uuid // ChargeCategory — nullable for legacy rows (backfill script)
  partyId                      String    @db.Uuid
  chargeType                   String
  status                       String
  description                  String?
  dueDate                      DateTime  @db.Date
  postedAt                     DateTime?
  amount                       Decimal   @db.Decimal(12, 2)
  currency                     String
  outstandingAmount            Decimal   @db.Decimal(12, 2)
  waivedReason                 String?
  cancelledReason              String?
  isDisputed                   Boolean   @default(false)
  disputeReason                String?
  disputeStatus                String?
  disputeResolution            String?
  disputeResolvedAt            DateTime?
  chargeableFrom               DateTime?
  chargeableTo                 DateTime?
  lateFeeApplied               Boolean   @default(false)
  lateFeeAmount                Decimal?  @db.Decimal(12, 2)
  parentChargeId               String?   @db.Uuid
  attachmentKeys               String[]
  // Phase-2 additive extension points (M3/M5) — nullable, no backfill
  invoiceId                    String?   @db.Uuid
  approvedBy                   String?   @db.Uuid // User.id — plain column
  approvedAt                   DateTime?
  billingMonth                 DateTime? @db.Date // matrix period key; null on legacy rows (chargeBillingMonth() derives)
  // Phase-2 (bills-grid Bill→invoice): tags charges minted by the bills-grid Bill so
  // re-Bill can find live invoices (filtered to ISSUED docs) and the double-count guard
  // can detect prior issuance. Real FK to UnitBillsGridEntry with SetNull on delete —
  // deleting a grid entry nulls this ref (never orphans it), keeping the re-Bill/
  // double-count logic (which locate live charges by sourceGridEntryId) correct.
  sourceGridEntryId            String?   @db.Uuid // UnitBillsGridEntry.id — FK, SetNull on delete
  // Recurring-charge LINE-level provenance (recurring-charges feature). Set ONLY on charges
  // minted from a GridEntryRecurringLine (custom recurring); null for utility/other charges.
  // The re-Bill RECLAIM key stays sourceGridEntryId (which recurring charges also carry) — this
  // is for invoice-line/owner-statement provenance. FK SetNull so a removed snapshot line never
  // orphan-cascades a billed Charge. NO backfill (existing charges predate the feature).
  sourceRecurringLineId        String?   @db.Uuid
  // Bill-expenses feature (spec R2): per-charge SST override. Null = derive from
  // category.defaultSstRate (today's behavior). Set to 0 or the standard rate by
  // expense minting so SST follows the expense's withSST flag, not the routing category.
  sstRate                      Decimal?  @db.Decimal(5, 2)
  // Bill-expenses feature (spec R4): provenance of a charge minted from a GridExpense.
  // FK SetNull so deleting the grid expense nulls this ref (never orphans the billed
  // charge). Null for all non-expense charges. Drives attachment resolution + re-Bill.
  sourceGridExpenseId          String?   @db.Uuid
  // Paid-on-behalf metadata (Task 9) — DISPLAY-ONLY, additive nullable. When KAEN
  // settled this expense (e.g. fire insurance) for the owner, who was paid + the
  // supplier reference + the payment date. Copied verbatim onto the synced
  // OwnerLedgerEntry; NEVER affects any money math.
  payeeName                    String? // who KAEN paid on the owner's behalf (e.g. "Allianz")
  paidOnBehalfRef              String? // supplier reference / invoice no. (e.g. "INV-1")
  paidOnBehalfDate             DateTime? @db.Date // date KAEN paid the payee
  // Phase-0 agency-accounting economic-treatment (additive, nullable, forward-only — no backfill).
  // Records WHO funded the cost, what the money IS, who it settles to, and its tax nature —
  // distinct questions ChargeCategory.family alone cannot answer. NEVER read for SST in this phase.
  // DB-ENFORCED: CHECK "Charge_fundedBy_check" (migration 20260727130000). The
  // authoritative vocabulary is FUNDED_BY (@kason/shared) — 5 values; this comment
  // previously listed only 4 and omitted "tenant_funded". Do not edit the list here:
  // change FUNDED_BY, then the constraint, then run the drift test
  // (apps/api/src/modules/billing/__tests__/charge-vocabulary-constraints.integration.test.ts).
  fundedBy                     String? // FUNDED_BY: owner|manager|tenant_direct|tenant_funded|third_party
  revenueRecognition           String? // "manager_revenue"|"owner_funds"|"recovery_of_advance"|"third_party_collection"
  settlementRecipient          String? // "manager"|"owner"|"third_party"|"none"
  // DB-ENFORCED: CHECK "Charge_nature_check" (migration 20260727130000), vocabulary
  // PROFIT_EXPENSE (@kason/shared). NULL still permitted (legacy rows).
  nature                       String? // "expense" | "profit" — drives EB/deduction routing (ENABLE_CHARGE_NATURE_ROUTING)
  sourceSupplier               String? // e.g. "TNB", "Air Selangor"
  sourceInvoiceIssuedTo        String? // "owner"|"tenant"|"manager"
  actualCost                   Decimal?  @db.Decimal(12, 2)
  markupAmount                 Decimal?  @db.Decimal(12, 2)
  taxTreatment                 String? // "taxable_service"|"exempt"|"out_of_scope_disbursement"|"reimbursement"|"pending_review"
  taxRate                      Decimal?  @db.Decimal(5, 2)
  taxReason                    String?
  taxDeterminedAt              DateTime?
  // Spec 1 rent-reclassification (Phase 1) — additive, nullable, forward-only. Authoritative
  // routing input alongside the economic-treatment columns above. commercialPurpose is NEVER
  // inferred from category name at runtime. provenance* is the Spec-3 work-order seam.
  commercialPurpose            String? // RENT|UTILITY|CARPARK|SERVICE|MANAGEMENT_FEE|OTHER_OWNER_COLLECTION
  provenanceType               String?
  provenanceId                 String?   @db.Uuid
  nonBillable                  Boolean   @default(false)
  economicClassificationStatus String? // null | "NEEDS_ECONOMIC_CLASSIFICATION"
  economicClassificationReason String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  organization                     Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenancy                          Tenancy?                          @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  unit                             Listing?                          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  carpark                          Carpark?                          @relation(fields: [carparkId], references: [id], onDelete: SetNull)
  category                         ChargeCategory?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoice                          Invoice?                          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sourceGridEntry                  UnitBillsGridEntry?               @relation("GridEntrySourcedCharges", fields: [sourceGridEntryId], references: [id], onDelete: SetNull)
  sourceRecurringLine              GridEntryRecurringLine?           @relation("RecurringLineSourcedCharges", fields: [sourceRecurringLineId], references: [id], onDelete: SetNull)
  sourceGridExpense                GridExpense?                      @relation("GridExpenseSourcedCharges", fields: [sourceGridExpenseId], references: [id], onDelete: SetNull)
  party                            Party                             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  events                           ChargeEvent[]
  allocations                      PaymentAllocation[]
  // Phase-2 owner remittance / receivable-offset (Spec 1) — back-relation for
  // OwnerReceivableOffsetAllocation.charge (the IVOWN receivable charge an offset settled).
  ownerReceivableOffsetAllocations OwnerReceivableOffsetAllocation[]

  @@unique([organizationId, chargeNumber])
  @@index([organizationId, partyId, status])
  @@index([organizationId, tenancyId, status])
  @@index([organizationId, dueDate, status])
  @@index([organizationId, status, postedAt])
  @@index([organizationId, invoiceId])
  @@index([organizationId, carparkId])
  @@index([organizationId, categoryId])
  @@index([organizationId, sourceGridEntryId])
  @@index([organizationId, sourceRecurringLineId])
  @@index([organizationId, sourceGridExpenseId])
  @@index([unitId])
}

