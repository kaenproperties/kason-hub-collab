model Tenancy {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @db.Uuid
  propertyId             String    @db.Uuid
  unitId                 String    @db.Uuid
  tenantPartyId          String    @db.Uuid
  tenancyCode            String
  status                 String
  billingStatus          String
  startDate              DateTime
  endDate                DateTime?
  monthlyRentAmount      Decimal   @db.Decimal(12, 2)
  depositAmount          Decimal?  @db.Decimal(12, 2)
  termMonths             Int?
  nextActionDate         DateTime?
  balanceDueAmount       Decimal?  @db.Decimal(12, 2)
  moveInChecklist        Json?
  moveOutChecklist       Json?
  depositDeductions      Json?
  depositRefundAmount    Decimal?  @db.Decimal(12, 2)
  depositRefundDate      DateTime?
  depositRefundNote      String?
  autoRenew              Boolean   @default(false)
  autoRenewTermMonths    Int?
  moveInNotes            String?
  moveOutNotes           String?
  statementSentAt        DateTime?
  previousTenancyId      String?   @unique @db.Uuid
  noticePeriodDays       Int?      @default(30)
  noticeGivenDate        DateTime?
  noticeGivenBy          String?
  // Renewal review is deliberately explicit: autoRenew cannot distinguish
  // "staff has not asked yet" from a confirmed "will not renew" decision.
  renewalDecision        String    @default("pending")
  renewalDecisionAt      DateTime?
  renewalContactedAt     DateTime?
  renewalNotes           String?
  overdueCount           Int       @default(0)
  lastOverdueAt          DateTime?
  // Phase-2 M1/M9 (O1 resolved 2026-06-11) — nullable, populated by import + forms
  numberOfPax            Int?
  agentLabel             String? // RAW Excel value; NO auto-normalization (M9 Yannie-reviewed merge)
  accessCardNo           String? // per-tenant card number(s), newline-tolerant
  // Rental-invoice scheduling (Day-1 meeting §5.1). Both nullable: existing
  // tenancies keep today's behaviour (first invoice derives from startDate,
  // subsequent invoices from the global DraftConfig.runDayOfMonth). "Following
  // months invoice on" is deliberately NOT a column -- it is the global 25th
  // (DraftConfig.runDayOfMonth), per Cadis: "the date is one global setting".
  rentInvoiceStartDate   DateTime?
  // Free-text label for a manually-keyed first month, e.g. "pro-rate".
  // Display-only; it never changes the computed amount.
  firstMonthRentNote     String?
  // First-month-rent-as-KAEN-commission (Phase 1, display-only). Additive +
  // defaulted so existing tenancies are behaviour-unchanged. commissionSstBearer
  // is "owner" | "kaen" (String, not a Prisma enum, per this schema's convention).
  firstMonthIsCommission Boolean   @default(false)
  // DB-ENFORCED: CHECK "Tenancy_commissionSstBearer_check" (owner|KAEN), migration 20260727140000.
  // Vocabulary source: COMMISSION_SST_BEARER — NOT owner|tenant, the tenant never bears KAEN's commission SST
  commissionSstBearer    String    @default("owner")
  // Set by deferred auto-deduct release; nullable until then.
  renovationClaimId      String?   @db.Uuid
  reservationId          String?   @unique @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property            Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Restrict: lease history must never be silently destroyed when a Unit
  // is deleted. Application code blocks Unit deletion if any Tenancy row
  // exists; this FK action is the defence-in-depth safety net.
  unit                Listing                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenantParty         Party                   @relation("TenancyParty", fields: [tenantPartyId], references: [id], onDelete: Cascade)
  previousTenancy     Tenancy?                @relation("TenancyRenewalChain", fields: [previousTenancyId], references: [id], onDelete: SetNull)
  renewedTenancy      Tenancy?                @relation("TenancyRenewalChain")
  renovationClaim     RenovationClaim?        @relation("TenancyRenovationClaim", fields: [renovationClaimId], references: [id], onDelete: SetNull)
  reservation         UnitReservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  charges             Charge[]
  carparkAssignments  CarparkAssignment[]
  utilityAllocations  UtilityAllocation[]
  recurringCharges    RecurringCharge[]
  deposits            Deposit[]
  maintenanceRequests MaintenanceRequest[]
  renovationOffsets   RenovationClaimOffset[]

  invoices   Invoice[]
  agreements TenancyAgreement[]

  @@unique([organizationId, tenancyCode])
  @@index([organizationId, status])
  @@index([organizationId, billingStatus])
  @@index([organizationId, unitId])
  @@index([organizationId, endDate])
  @@index([organizationId, status, renewalDecision, endDate])
  @@index([organizationId, tenantPartyId, status])
  @@index([propertyId])
  @@index([renovationClaimId])
}

model LandlordTenancy {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
