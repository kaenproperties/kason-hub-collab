model OwnerLedgerEntry {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @db.Uuid
  ownerPartyId            String    @db.Uuid // owner is per-unit via Listing.ownerPartyId (resolution moved off LandlordTenancy.landlordId) — plain column
  // Task 6a (Phase-2 owner remittance): NULLABLE. null = this row belongs to the
  // owner OVERALL and is not attributable to one property — NOT "unknown", NOT
  // invalid data, NOT a nil-UUID sentinel. A cross-property (R9) or combined-scope
  // Phase-2 remittance payout has no single meaningful propertyId. Precedent:
  // ManagementFeeConfig.propertyId (below) is already nullable with the identical
  // "null = all the owner's properties" semantic. Property-specific reads
  // (propertyId-filtered) correctly EXCLUDE a null row (Postgres `=`/`IN` never
  // match NULL) — that is by design, not a gap: a property-level breakdown of a
  // remittance is derived from OwnerRemittanceAllocation rows, never from this
  // column. Owner-level (all-property) reads must omit the propertyId filter
  // entirely so both property-specific AND null rows are included. Every
  // money-critical balance primitive (computeOwnerRunningBalance,
  // resolveOwnerBalance, computeAvailableOwnerPayableC) is propertyId-agnostic —
  // none of them filter or group by this column.
  propertyId              String?   @db.Uuid // plain column
  apartmentId             String?   @db.Uuid // plain column; the Apartment (unit) anchor
  listingId               String?   @db.Uuid // the per-room "Unit"; null = property-level
  tenancyId               String?   @db.Uuid
  statementMonth          DateTime  @db.Date // first-of-month grouping key
  transactionDate         DateTime  @db.Date
  direction               String // "income" | "expense" | "payout"
  category                String // OWNER_LEDGER_CATEGORIES
  description             String?
  remarks                 String?
  amount                  Decimal   @db.Decimal(12, 2)
  sstAmount               Decimal?  @db.Decimal(12, 2)
  paidBy                  String // OWNER_PAID_BY
  paymentStatus           String    @default("paid")
  taxCategory             String    @default("check_with_tax_agent")
  includeInPayout         Boolean   @default(true) // derived: paidBy == "kaen"
  attachmentKeys          String[]  @default([])
  sourceType              String    @default("manual") // "rent" | "statement" | "utility" | "manual"
  sourceChargeId          String?   @db.Uuid
  sourceInvoiceId         String?   @db.Uuid
  sourceUtilityBillId     String?   @db.Uuid
  // R3 forward-collection idempotency: the triggering PaymentAllocation / PaymentAllocationReversal
  // event id. Non-null only on prior_period_collection / prior_period_collection_reversal rows.
  sourceAllocationEventId String?   @db.Uuid
  // Paid-on-behalf metadata (Task 9) — DISPLAY-ONLY, additive nullable. Copied from
  // the source Charge by owner-ledger.sync (source-2) so the statement/receipt can
  // document "KAEN paid <payee> on your behalf". NEVER part of the payout formula.
  payeeName               String? // who KAEN paid on the owner's behalf (e.g. "Allianz")
  paidOnBehalfRef         String? // supplier reference / invoice no. (e.g. "INV-1")
  paidOnBehalfDate        DateTime? @db.Date // date KAEN paid the payee
  status                  String    @default("active") // "active" | "void"
  createdById             String    @db.Uuid // User.id — plain column
  updatedById             String    @db.Uuid // User.id — plain column; sync sentinel id ⇒ "untouched by admin"
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Spec 1 Phase-2 owner remittance / offset / reversal / idempotency — additive, nullable.
  settlementKind        String? // OWNER_REMITTANCE | OWNER_RECEIVABLE_OFFSET | PRE_STATEMENT_REMITTANCE (null = legacy/sync payout)
  paymentMethod         String? // bank_transfer | cash | cheque | other  (real remittances only; null for offsets)
  bankReference         String?
  proofKey              String?
  proofStatus           String? // PROOF_PENDING | PROOF_ATTACHED
  memo                  String?
  idempotencyKey        String?
  requestFingerprint    String?
  reversalOfEntryId     String?                           @db.Uuid // ONE-WAY: set only on a reversal entry; original carries no back-pointer
  // Accounting-doc redesign P1 (2026-07-23): human-facing sequential DISPLAY number
  // for a real cash-out payout row, e.g. "REM-0001" — minted from the REM
  // DocumentSeries (mintDocumentNumberTx) ONLY at the recordRemittanceService write
  // (settlementKind OWNER_REMITTANCE / PRE_STATEMENT_REMITTANCE), gated behind
  // ENABLE_OWNER_DOC_NUMBERING. Deliberately NEVER minted for an
  // OWNER_RECEIVABLE_OFFSET payout or a reversal row (reversalOfEntryId set) —
  // neither is new cash to the owner. NEVER the dedupe/identity key — that stays
  // `idempotencyKey`, untouched. Additive + nullable.
  remittanceNumber      String?
  remittanceAllocations OwnerRemittanceAllocation[]
  offsetAllocations     OwnerReceivableOffsetAllocation[]

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // R3: forward-collection idempotency. Each PaymentAllocation(Reversal) event yields exactly one
  // prior_period_collection / prior_period_collection_reversal row. Postgres NULLs-distinct ⇒ existing
  // rows (null sourceAllocationEventId) stay unconstrained. Explicit map: keeps the index name < 63 chars
  // and deterministic so the hand-authored migration matches.
  @@unique([organizationId, sourceType, sourceAllocationEventId], map: "OwnerLedgerEntry_org_sourceType_allocEvent_key")
  // The former @@unique([organizationId, sourceType, sourceChargeId]) is intentionally NOT declared here:
  // Prisma 7 cannot express a PARTIAL unique. It is recreated in the migration as a partial unique index
  // EXCLUDING ('prior_period_collection','prior_period_collection_reversal','reversal_forward_adjustment')
  // — those legitimately have multiple rows per charge (ppc/ppc_reversal one per allocation event, keyed by
  // the alloc-event unique above; reversal_forward_adjustment one per OPEN month it corrects into, keyed by
  // the per-(charge, statementMonth) partial unique OwnerLedgerEntry_org_revFwdAdj_charge_month_key).
  // prior_period_adjustment and the write-once `reversal` stay covered by the broad partial index (exactly
  // one per charge). See migrations 20260720000000_closed_period_integrity_schema (broad index) and
  // 20260720100000_reversal_forward_adjustment_partial_unique (new exclusion + per-month unique).
  // C2: utility rows carry no sourceChargeId; deduplicate on sourceUtilityBillId instead.
  // Postgres NULLs-distinct ⇒ manual/rent/statement rows (null sourceUtilityBillId) are unconstrained.
  @@unique([organizationId, sourceType, sourceUtilityBillId])
  // Spec 1 Phase-2 owner remittance / offset / reversal / idempotency indexes.
  @@unique([organizationId, settlementKind, idempotencyKey])
  @@index([organizationId, ownerPartyId, statementMonth])
  @@index([organizationId, apartmentId, statementMonth])
  @@index([organizationId, propertyId])
  @@index([organizationId, direction, category])
  @@index([organizationId, ownerPartyId, settlementKind])
  @@index([reversalOfEntryId])
}

model OwnerStatementPeriod {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  ownerPartyId       String    @db.Uuid
  apartmentId        String?   @db.Uuid // null = combined scope; set = per-unit
  periodMonth        DateTime  @db.Date // first-of-month key (UTC)
  status             String    @default("open") // "open" | "frozen"
  issuedAt           DateTime?
  openingBalanceC    Int       @default(0)
  closingBalanceC    Int       @default(0)
  netPayoutC         Int       @default(0)
  snapshotJson       Json? // frozen line items as of freeze
  pdfKey             String?
  idempotencyKey     String // ownerstmt:<owner>:<YYYY-MM>[:<apartmentId>]
  sourceMaxUpdatedAt DateTime // monotonic-write guard
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // R7 write-once freeze header — set ONLY on first freeze, never overwritten (immutability baseline).
  // A later re-freeze that changes persisted balances is itself detectable via R6(d) frozen_balance_drift.
  firstFrozenAt        DateTime?
  firstFrozenOpeningC  Int?
  firstFrozenClosingC  Int?
  firstFrozenNetC      Int?
  freezeRulesetVersion Int?

  organization               Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Spec 1 Phase-2 owner remittance — back-relation for OwnerRemittanceAllocation.period.
  ownerRemittanceAllocations OwnerRemittanceAllocation[]
  freezeManifestRows         OwnerStatementFreezeManifestRow[]

  @@unique([organizationId, ownerPartyId, apartmentId, periodMonth])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, ownerPartyId, periodMonth])
  @@index([organizationId, apartmentId, periodMonth])
}

model OwnerRemittanceAllocation {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @db.Uuid
  payoutEntryId          String               @db.Uuid // → OwnerLedgerEntry (the payout row)
  ownerStatementPeriodId String               @db.Uuid // → OwnerStatementPeriod (owner×apartment×month)
  allocatedAmountC       Int // integer cents; > 0
  createdById            String               @db.Uuid
  createdAt              DateTime             @default(now())
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payoutEntry            OwnerLedgerEntry     @relation(fields: [payoutEntryId], references: [id], onDelete: Cascade)
  period                 OwnerStatementPeriod @relation(fields: [ownerStatementPeriodId], references: [id], onDelete: Restrict)

  @@unique([organizationId, payoutEntryId, ownerStatementPeriodId])
  @@index([organizationId, ownerStatementPeriodId])
  @@index([organizationId, payoutEntryId])
}

model OwnerReceivableOffsetAllocation {
  id                    String           @id @default(uuid()) @db.Uuid
  organizationId        String           @db.Uuid
  offsetEntryId         String           @db.Uuid // → OwnerLedgerEntry (settlementKind=OWNER_RECEIVABLE_OFFSET)
  chargeId              String           @db.Uuid // → Charge (the IVOWN receivable charge whose outstanding this settled)
  billingDocumentLineId String?          @db.Uuid // display/trace only; settlement is at the charge grain
  allocatedAmountC      Int // integer cents; > 0
  createdById           String           @db.Uuid
  createdAt             DateTime         @default(now())
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offsetEntry           OwnerLedgerEntry @relation(fields: [offsetEntryId], references: [id], onDelete: Cascade)
  charge                Charge           @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, offsetEntryId, chargeId])
  @@index([organizationId, chargeId])
  @@index([organizationId, offsetEntryId])
}

// R7 — immutable, write-once freeze manifest. One row per ACTIVE OwnerLedgerEntry (any paymentStatus)
// captured at FIRST freeze of a period-scope. snapshotJson is insufficient (paid-only; omits
// includeInPayout/sstAmount and unpaid-active rows). Never overwritten by a re-freeze. Serves R6.
model OwnerStatementFreezeManifestRow {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @db.Uuid
  ownerStatementPeriodId  String   @db.Uuid
  ownerPartyId            String   @db.Uuid
  apartmentId             String?  @db.Uuid
  periodMonth             DateTime @db.Date
  ledgerEntryId           String   @db.Uuid
  amountC                 Int
  direction               String
  category                String
  paidBy                  String
  includeInPayout         Boolean
  paymentStatus           String
  sstAmountC              Int?
  statementMonth          DateTime @db.Date
  sourceType              String
  sourceChargeId          String?  @db.Uuid
  ledgerUpdatedAtAtFreeze DateTime
  createdAt               DateTime @default(now())

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerStatementPeriod OwnerStatementPeriod @relation(fields: [ownerStatementPeriodId], references: [id], onDelete: Cascade)

  // Write-once (one row per ledger entry) is enforced by the freeze SERVICE, not the DB, so a buggy
  // re-freeze double-write is surfaced by R6 as a manifest diff rather than silently rejected here.
  @@index([organizationId, ownerStatementPeriodId], map: "OwnerStmtFreezeManifest_org_period_idx")
}

// R5/R6/R8 — durable reconciliation finding. Survives beyond AuditLog's 10-day purge. Idempotent upsert
// on the dedupe key; lastDetectedAt bumped on re-detect; auto-resolved when valid data reappears.
model OwnerLedgerReconciliationFinding {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  ownerPartyId         String    @db.Uuid
  apartmentId          String?   @db.Uuid
  unitId               String?   @db.Uuid
  carparkId            String?   @db.Uuid
  checkKind            String // "source_to_ledger" | "frozen_integrity"
  findingType          String // missing_ledger_row | stale_collected_amount | invalid_forward_adjustment | post_freeze_creation | post_freeze_economic_edit | manifest_field_mismatch | frozen_balance_drift | unexplained_frozen_row
  sourceType           String
  sourceId             String    @db.Uuid
  sourceUpdatedAt      DateTime?
  originalBillingMonth DateTime? @db.Date
  expectedPostingMonth DateTime? @db.Date
  expectedDirection    String?
  expectedAmountC      Int?
  actualAmountC        Int?
  severity             String // "critical" | "warning"
  status               String    @default("open") // "open" | "acknowledged" | "resolved" | "ignored"
  reason               String? // required on ignore (enforced by service)
  firstDetectedAt      DateTime  @default(now())
  lastDetectedAt       DateTime
  resolvedAt           DateTime?
  resolvedById         String?   @db.Uuid
  detailsJson          Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, checkKind, sourceType, sourceId, findingType], map: "OwnerLedgerReconFinding_dedupe_key")
  @@index([organizationId, status, severity], map: "OwnerLedgerReconFinding_org_status_sev_idx")
  @@index([organizationId, ownerPartyId, checkKind], map: "OwnerLedgerReconFinding_org_owner_check_idx")
}

// R8/R9 — durable reconciliation run record. One per (type, scope) execution; feeds the enablement preflight.
model OwnerLedgerReconciliationRun {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  reconciliationType String // "source_to_ledger" | "frozen_integrity"
  scopeJson          Json? // owner/month filters, or null/{full:true} for full scope
  isFullScope        Boolean
  status             String    @default("running") // "running" | "completed" | "failed"
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  sourcesScanned     Int       @default(0)
  findingsOpened     Int       @default(0)
  findingsResolved   Int       @default(0)
  triggerType        String // "cron" | "manual"
  triggeredById      String?   @db.Uuid
  failureInfo        String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, reconciliationType, status], map: "OwnerLedgerReconRun_org_type_status_idx")
  @@index([organizationId, startedAt], map: "OwnerLedgerReconRun_org_startedAt_idx")
}

