generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ╔══════════════════════════════════════════════════════════════════════════════╗
// ║  DB-LEVEL CONSTRAINTS THAT PRISMA CANNOT SEE — READ THIS BEFORE EDITING      ║
// ╚══════════════════════════════════════════════════════════════════════════════╝
//
// Prisma has no CHECK-constraint support, so `prisma migrate diff` reports NOTHING
// for the constraints below and `prisma format` will not preserve them. They exist
// only in hand-authored migration SQL. This block is the index of what is really in
// the database, so the next person does not have to discover it from a 500.
//
// ── 15 CHECK constraints (column vocabularies) ────────────────────────────────
// Migration 20260727130000_charge_nature_fundedby_checks
//   Charge.nature                            expense | profit          -> PROFIT_EXPENSE
//   Charge.fundedBy                          5 values                  -> FUNDED_BY
// Migration 20260727140000_bearer_vocabulary_checks
//   UnitUtilityBill.{indahWater,cleaning,wifi}Bearer      owner|tenant -> `bearer` (bills-grid.ts)
//   UnitBillsGridEntry.{cleaning,wifi,maintenanceFee}Bearer  owner|tenant
//   UnitBillsBearerConfig.{cleaning,wifi,maintenanceFee}Bearer owner|tenant
//   GridExpense.bearer / RecurringChargeRevision.bearer /
//   GridEntryRecurringLine.bearer                         owner|tenant
//   Tenancy.commissionSstBearer              owner | KAEN  -> COMMISSION_SST_BEARER
//     ^ DELIBERATELY a different vocabulary from the others despite the name.
//       The tenant never bears the SST on KAEN's own letting commission.
//
// ── 46 foreign-key indexes ────────────────────────────────────────────────────
// Migration 20260727120000_fk_indexes_and_explicit_ondelete. These ARE expressed as
// @@index below, so Prisma does see them. Same migration made 14 onDelete actions
// explicit — each set to the action Prisma already applied implicitly, so it emitted
// zero SQL and changed no behaviour.
//
// ── RULES ─────────────────────────────────────────────────────────────────────
// 1. Changing a vocabulary means changing THREE things together: the `as const`
//    array in @kason/shared, a NEW migration altering the CHECK, and the drift test.
//    Never edit an applied migration — the checksum in _prisma_migrations will
//    mismatch and `migrate deploy` can refuse to run.
// 2. Before constraining any NEW column, run the read-only audit FIRST:
//      psql "$DSN" -tAF'|' -f scripts/audit-column-vocabularies.sql
//    A vocabulary derived from reading code alone was wrong on three columns on
//    2026-07-27; only real data caught it.
// 3. The drift guard lives at
//    apps/api/src/modules/billing/__tests__/charge-vocabulary-constraints.integration.test.ts
//    It is a DEVELOPER check, not a CI gate — no workflow sets RUN_INTEGRATION.
//    Run it with: RUN_INTEGRATION=1 npx --workspace @kason/api vitest run <that file>
//
// Deploy reality: UAT applies these automatically (cd-uat-deploy.yml:150). PROD does
// NOT — cd-prod-deploy.yml runs no migrations; prod changes go through the manual
// psql/pg_dump process.

model Organization {
  id                        String   @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String   @unique
  status                    String
  defaultCurrency           String
  timezone                  String
  locale                    String
  subscriptionPlan          String
  billingCycleMode          String   @default("calendar")
  billLeadDays              Int      @default(30)
  tenancyExpiryReminderDays Int      @default(30)
  reservationLinkExpiryDays Int      @default(7)
  currencyDisplay           String   @default("code")
  managementFeePercent      Decimal  @default(10) @db.Decimal(5, 2)
  // ── Owner-statement auto-send schedule ──────────────────────────────────────
  // WHEN the just-ended month's frozen owner statements go out, expressed in the
  // org's own `timezone` above (never UTC — an admin picking "the 3rd at 09:00"
  // means their local 3rd).
  //
  // Day is capped at 28 so every month has one: a sendDay of 30 would silently
  // never fire in February. Both are additive with defaults, so existing rows get
  // "the 3rd at 09:00 local" without a backfill.
  //
  // Read by the send cron (apps/api/src/cron/send-owner-statements.ts), which
  // treats these as a THRESHOLD, not an exact match — a statement due on the 3rd
  // that missed its run still goes out on the 4th. That is what makes "August's
  // statement can go any time in September" true rather than a single fragile
  // instant.
  ownerStatementSendDay     Int      @default(3)
  ownerStatementSendHour    Int      @default(9)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  users                          User[]
  roleAssignments                RoleAssignment[]
  properties                     Property[]
  buildings                      Building[]
  units                          Listing[]
  parties                        Party[]
  partyRoles                     PartyRole[]
  tenancies                      Tenancy[]
  landlordTenancies              LandlordTenancy[]
  deposits                       Deposit[]
  charges                        Charge[]
  chargeEvents                   ChargeEvent[]
  chargeTemplates                ChargeTemplate[]
  recurringCharges               RecurringCharge[]
  lateFeeRules                   LateFeeRule[]
  payments                       Payment[]
  paymentAllocations             PaymentAllocation[]
  bills                          CommissionBill[]
  cashMovements                  CashMovement[]
  notifications                  Notification[]
  notificationQueue              NotificationQueue[]
  emailTemplates                 EmailTemplate[]
  auditLogs                      AuditLog[]
  activityLogs                   ActivityLog[]
  unitAttributes                 UnitAttribute[]
  maintenanceRequests            MaintenanceRequest[]
  documents                      Document[]
  documentLinks                  DocumentLink[]
  supplierExpenses               SupplierExpense[]
  supplierExpenseAllocations     SupplierExpenseAllocation[]
  supplierExpenseCostAssignments SupplierExpenseCostAssignment[]
  bankCostAllocations            BankCostAllocation[]
  kaenOperatingExpenses          KaenOperatingExpense[]
  ownerFundingRequests           OwnerFundingRequest[]
  announcements                  Announcement[]
  agentTierMappings              AgentTierMapping[]
  commissionClaims               CommissionClaim[]
  commissionClaimItems           CommissionClaimItem[]
  roomTypes                      RoomType[]
  amenities                      Amenity[]
  workCategories                 WorkCategory[]
  propertyTypes                  PropertyType[]
  agentLevelThresholds           AgentLevelThreshold[]
  listingVisibilityGrants        ListingVisibilityGrant[]
  taTiers                        TaTier[]
  notificationLogs               NotificationLog[]
  icAccessLogs                   IcAccessLog[]
  pendingUploads                 PendingUpload[]

  // Sales Entry + Renovation Claim module (Wave 1)
  projects                       Project[]
  salesUnits                     SalesUnit[]
  renovationProgresses           RenovationProgress[]
  renovationTransitions          RenovationTransition[]
  renovationPackages             RenovationPackage[]
  renovationPackageSplits        RenovationPackageSplit[]
  renovationClaims               RenovationClaim[]
  renovationClaimSplits          RenovationClaimSplit[]
  renovationClaimDocuments       RenovationClaimDocument[]
  renovationClaimTransitions     RenovationClaimTransition[]
  renovationClaimOffsets         RenovationClaimOffset[]
  salesClaims                    SalesClaim[]
  salesClaimSplits               SalesClaimSplit[]
  salesClaimTransitions          SalesClaimTransition[]
  settingsLabels                 SettingsLabel[]
  renovationStages               RenovationStage[]
  renovationStageProgress        RenovationStageProgress[]
  salesClaimDefaults             SalesClaimDefault[]
  salesClaimDefaultSplits        SalesClaimDefaultSplit[]
  projectVerificationTransitions ProjectVerificationTransition[]

  cardSettings                         OrganizationCardSettings?
  cardVersions                         AgentCardVersion[]
  documentTemplates                    DocumentTemplate[]
  tenancyAgreements                    TenancyAgreement[]
  tenancyAgreementTemplates            TenancyAgreementTemplate[]
  propertyManagementAgreementTemplates PropertyManagementAgreementTemplate[]
  propertyManagementAgreements         PropertyManagementAgreement[]
  referenceSequences                   ReferenceSequence[]

  unitReservations           UnitReservation[]
  unitReservationTransitions UnitReservationTransition[]
  unitReservationDocuments   UnitReservationDocument[]

  apartments          Apartment[]
  unitSubmissions     UnitSubmission[]
  propertySubmissions PropertySubmission[]

  invoices                         Invoice[]
  aircondMeters                    AircondMeter[]
  meterReadings                    MeterReading[]
  managementFeeConfigs             ManagementFeeConfig[]
  ownerLedgerEntries               OwnerLedgerEntry[]
  ownerExpenseProofs               OwnerExpenseProof[]
  tasks                            Task[]
  sprints                          Sprint[]
  tickets                          Ticket[]
  ticketHistories                  TicketHistory[]
  deviceTokens                     DeviceToken[]
  draftConfigs                     DraftConfig[]
  utilityBillingConfig             UtilityBillingConfig[]
  invoiceDraftRuns                 InvoiceDraftRun[]
  importRuns                       ImportRun[]
  unitUtilityBills                 UnitUtilityBill[]
  utilityAllocations               UtilityAllocation[]
  unitUtilityBillAttachments       UnitUtilityBillAttachment[]
  carparks                         Carpark[]
  carparkAssignments               CarparkAssignment[]
  chargeCategories                 ChargeCategory[]
  documentSeries                   DocumentSeries[]
  billingDocuments                 BillingDocument[]
  creditApplications               CreditApplication[]
  refunds                          Refund[]
  unitMonthLedgers                 UnitMonthLedger[]
  ownerStatementPeriods            OwnerStatementPeriod[]
  // Phase-2 owner remittance / receivable-offset (Spec 1) — back-relations required by
  // OwnerRemittanceAllocation.organization / OwnerReceivableOffsetAllocation.organization below.
  ownerRemittanceAllocations       OwnerRemittanceAllocation[]
  ownerReceivableOffsetAllocations OwnerReceivableOffsetAllocation[]

  // Closed-period integrity (R7 freeze manifest, R8 durable reconciliation)
  ownerStatementFreezeManifestRows  OwnerStatementFreezeManifestRow[]
  ownerLedgerReconciliationFindings OwnerLedgerReconciliationFinding[]
  ownerLedgerReconciliationRuns     OwnerLedgerReconciliationRun[]

  // Bills & Expenses Grid (standalone store — never writes Charge/OwnerLedgerEntry/UnitUtilityBill)
  unitBillsGridEntries   UnitBillsGridEntry[]
  gridExpenses           GridExpense[]
  gridMeterReadings      GridMeterReading[]
  unitBillsBearerConfigs UnitBillsBearerConfig[]
  gridAttachments        GridAttachment[]

  @@index([status])
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  email              String
  phone              String?
  fullName           String
  passwordHash       String?
  status             String
  role               String    @default("admin")
  /// Per-user capability exceptions. Keys are permission codes and values are
  /// true (grant) or false (deny). Missing keys inherit the selected role.
  permissionOverrides Json     @default("{}") @map("permission_overrides")
  userType           String    @default("operator")
  /// INVARIANT: every User where userType="operator" MUST have a paired
  /// Party row (partyType="individual") and link to it via partyId. The
  /// invariant exists because Listing.inChargePartyId is FK → Party.id —
  /// any operator that lacks a Party silently drops out of the in-charge
  /// picker (and every other surface that resolves an actor via Party).
  /// createUserService writes both in one transaction; the
  /// scripts/backfill-operator-parties.ts one-shot covers pre-fix rows.
  /// Kept nullable here because partyId was added retro to a populated
  /// table — a NOT NULL migration is queued for after the Pro+PITR
  /// unlock (see CLAUDE.md "UAT data safety — pre-PITR" + the freeze
  /// spec). Treat NULL as a bug, not a valid state.
  partyId            String?   @unique @db.Uuid
  emailVerified      Boolean   @default(false)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  verificationToken  String?
  resetTokenHash     String?   @map("reset_token_hash")
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  lastLoginAt        DateTime?
  photoKey           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party                 Party?                   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  roleAssignments       RoleAssignment[]
  properties            Property[]
  auditLogs             AuditLog[]
  listingGrantsIssued   ListingVisibilityGrant[]
  icAccessLogsViewed    IcAccessLog[]
  cardVersionsSubmitted AgentCardVersion[]       @relation("CardVersionSubmitter")
  cardVersionsReviewed  AgentCardVersion[]       @relation("CardVersionReviewer")

  unitSubmissionsApproved     UnitSubmission[]     @relation("UnitSubmissionApprover")
  propertySubmissionsApproved PropertySubmission[] @relation("PropertySubmissionApprover")

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model RoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String
  scopeType      String
  scopeId        String?  @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([organizationId, role])
}

model Property {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  name                String
  propertyCode        String
  propertyType        String
  addressLine1        String
  addressLine2        String?
  city                String
  state               String?
  postalCode          String?
  country             String
  status              String
  publishStatus       String
  managerId           String?   @db.Uuid
  insuranceProvider   String?
  insurancePolicyNo   String?
  insuranceExpiryDate DateTime?
  insuranceCoverage   Decimal?  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager              User?                 @relation(fields: [managerId], references: [id], onDelete: SetNull)
  buildings            Building[]
  tenancies            Tenancy[]
  bills                CommissionBill[]
  cashMovements        CashMovement[]
  landlordTenancies    LandlordTenancy[]
  commissionClaimItems CommissionClaimItem[]
  promotedFromProjects Project[]
  unitReservations     UnitReservation[]
  hasPaxDeduction      Boolean               @default(false)
  paxDeductionAmount   Decimal?              @db.Decimal(8, 2)

  apartments                       Apartment[]
  carparks                         Carpark[]
  unitSubmissionsProposingProperty UnitSubmission[]     @relation("UnitSubmissionProperty")
  propertySubmissionsApproved      PropertySubmission[] @relation("PropertySubmissionApprovedProperty")

  @@unique([organizationId, propertyCode])
  @@index([organizationId, status])
  @@index([managerId])
}

model Building {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  propertyId     String   @db.Uuid
  name           String
  code           String?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([organizationId, propertyId, code])
  @@index([organizationId, propertyId])
}

model Apartment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId     String @db.Uuid
  unitCode       String

  listingMode          ListingMode
  // Partition utility-billing model (only meaningful when listingMode = PARTITIONED;
  // WHOLE units always have the single tenant bear all). See 2026-06-18 spec.
  partitionBillingMode UtilityBillingMode @default(NO_SUBSIDY)
  /// Optional owner cap for the unit's shared TNB remainder in one billing
  /// month. A value takes priority over the legacy partition billing mode.
  /// Null defers to that mode: SUBSIDY uses the organization-level per-pax
  /// policy, while NO_SUBSIDY provides no owner subsidy.
  /// DB-ENFORCED: CHECK "Apartment_tnbSubsidyCapMonthly_check" (NULL or >= 0).
  tnbSubsidyCapMonthly Decimal?           @db.Decimal(12, 2)
  underManagement      Boolean            @default(true)

  bedrooms             Int?
  bathrooms            Decimal? @db.Decimal(4, 1)
  floorArea            Decimal? @db.Decimal(12, 2)
  floor                Int?
  facing               String?
  furnishingLevel      String?
  amenities            String[] @default([])
  highlights           String[] @default([])
  publishedDescription String?
  publishedTitle       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listings         Listing[]
  carparks         Carpark[]
  unitUtilityBills UnitUtilityBill[]

  // Bills & Expenses Grid. The three child tables carry a denormalised
  // `apartmentId` plain column with NO relation, so they need no back-relation here.
  unitBillsGridEntries   UnitBillsGridEntry[]
  unitBillsBearerConfigs UnitBillsBearerConfig[]

  @@unique([organizationId, propertyId, unitCode])
  @@index([organizationId, propertyId])
  @@index([organizationId, listingMode])
}

model UnitSubmission {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  propertyId           String?     @db.Uuid
  propertySubmissionId String?     @db.Uuid
  unitCode             String
  listingType          String
  listingMode          ListingMode

  parentListingId String? @db.Uuid

  sourcingAgentId String @db.Uuid

  submissionState  SubmissionState
  amendmentNote    String?
  submittedPayload Json

  approvedAt        DateTime?
  approvedById      String?   @db.Uuid
  approvedListingId String?   @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property           Property?           @relation("UnitSubmissionProperty", fields: [propertyId], references: [id], onDelete: SetNull)
  propertySubmission PropertySubmission? @relation(fields: [propertySubmissionId], references: [id], onDelete: SetNull)
  sourcingAgent      Party               @relation("UnitSubmissionSourcingAgent", fields: [sourcingAgentId], references: [id], onDelete: Restrict)
  approvedBy         User?               @relation("UnitSubmissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedListing    Listing?            @relation("UnitSubmissionApprovedListing", fields: [approvedListingId], references: [id], onDelete: SetNull)

  @@index([organizationId, submissionState, createdAt])
  @@index([organizationId, sourcingAgentId, submissionState])
  @@index([organizationId, parentListingId])
  @@index([approvedById])
  @@index([propertyId])
  @@index([propertySubmissionId])
}

model PropertySubmission {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  propertyCode String
  proposedName String
  propertyType String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String

  sourcingAgentId  String          @db.Uuid
  submissionState  SubmissionState
  amendmentNote    String?
  submittedPayload Json

  approvedAt         DateTime?
  approvedById       String?   @db.Uuid
  approvedPropertyId String?   @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourcingAgent    Party        @relation("PropertySubmissionSourcingAgent", fields: [sourcingAgentId], references: [id], onDelete: Restrict)
  approvedBy       User?        @relation("PropertySubmissionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedProperty Property?    @relation("PropertySubmissionApprovedProperty", fields: [approvedPropertyId], references: [id], onDelete: SetNull)

  unitSubmissions UnitSubmission[]

  @@index([organizationId, submissionState, createdAt])
  @@index([organizationId, sourcingAgentId, submissionState])
  @@index([approvedById])
}

model Listing {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @db.Uuid
  apartmentId             String   @db.Uuid
  listingType             String
  occupancyStatus         String
  listingStatus           String
  baseRentAmount          Decimal? @db.Decimal(12, 2)
  currency                String
  rentalRate              Decimal? @db.Decimal(12, 2)
  depositMonths           Decimal? @default(2) @db.Decimal(4, 2)
  // Optional deposits — defaults are computed client-side from rentalRate
  // (see packages/shared/src/deposits.ts). NULL = uploader did not record;
  // distinct from "uploader confirmed the default."
  utilitiesDepositMonths  Decimal? @db.Decimal(4, 2)
  accessCardDepositPerPcs Decimal? @db.Decimal(8, 2)
  accessCardQuantity      Int?

  // Parking — quantity sets the number of slots; numbers is an aligned
  // string array (length matches quantity, or is empty if uploader skipped
  // numbering).
  parkingQuantity Int?
  parkingNumbers  String[] @default([])

  // Media — scoped per Listing (per room type) as of 2026-05-24.
  // See docs/superpowers/specs/2026-05-24-per-room-unit-media-design.md.
  // For a PARTITIONED apartment, Master / Medium / Small each own their
  // own gallery; uploading to one does not affect the others.
  photoKeys     String[] @default([])
  coverPhotoKey String?
  videoKeys     String[] @default([])

  vacantSince        DateTime?
  moveInDate         DateTime?
  readyNow           Boolean        @default(false)
  inChargeName       String?
  inChargePartyId    String?        @db.Uuid
  ownerPartyId       String?        @db.Uuid
  sourcingAgentId    String?        @db.Uuid
  visibilityMode     VisibilityMode @default(PUBLIC)
  hiddenFromPartyIds String[]       @default([])
  // Back-pointer when a SalesUnit auto-promotes into this Listing on
  // RenovationProgress.status=completed for purpose=rent.
  salesUnitOriginId  String?        @unique @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartment             Apartment                @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  tenancies             Tenancy[]
  unitReservations      UnitReservation[]
  attributes            UnitAttribute[]
  charges               Charge[]
  utilityAllocations    UtilityAllocation[]
  deposits              Deposit[]
  inChargeParty         Party?                   @relation("UnitInCharge", fields: [inChargePartyId], references: [id], onDelete: SetNull)
  ownerParty            Party?                   @relation("UnitOwner", fields: [ownerPartyId], references: [id], onDelete: Restrict)
  sourcingAgent         Party?                   @relation("UnitSourcingAgent", fields: [sourcingAgentId], references: [id], onDelete: SetNull)
  visibilityGrants      ListingVisibilityGrant[]
  // Inverse of SalesUnit.promotedUnit
  promotedFromSalesUnit SalesUnit?               @relation("SalesUnitPromotedUnit")
  // Forward FK: when a SalesUnit auto-promotes, this Listing points back to it.
  salesUnitOrigin       SalesUnit?               @relation("UnitSalesUnitOrigin", fields: [salesUnitOriginId], references: [id], onDelete: SetNull)

  amendmentSubmissions UnitSubmission[] @relation("UnitSubmissionApprovedListing")

  aircondMeters   AircondMeter[]
  meterReadings   MeterReading[]
  tickets         Ticket[]
  ticketHistories TicketHistory[]
  relatedTasks    Task[]

  @@unique([apartmentId, listingType])
  @@index([organizationId, listingStatus])
  @@index([apartmentId, listingStatus])
  @@index([organizationId, sourcingAgentId])
  @@index([organizationId, ownerPartyId])
  @@index([inChargePartyId])
  @@map("Unit")
}

/// A physical parking bay owned via its home apartment. Replaces the old
/// Listing.unitKind="carpark" pseudo-room. Rented to a unit tenant via
/// CarparkAssignment; rent always foots to ownerPartyId (the bay's owner).
model Carpark {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  propertyId     String  @db.Uuid // the building — drives the "available bays in this condo" picker
  apartmentId    String  @db.Uuid // home apartment → the bay's owner
  ownerPartyId   String? @db.Uuid // mirrors the apartment's Listing.ownerPartyId
  label          String // e.g. "P-12"
  monthlyRate    Decimal @db.Decimal(12, 2) // default charge when assigned
  status         String  @default("available") // "available" | "rented" | "inactive"
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  apartment    Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  ownerParty   Party?              @relation("CarparkOwner", fields: [ownerPartyId], references: [id], onDelete: Restrict)
  assignments  CarparkAssignment[]
  charges      Charge[]

  @@index([organizationId, propertyId, status])
  @@index([organizationId, apartmentId])
  @@index([organizationId, ownerPartyId])
}

/// Links a parking bay to the renter's ROOM tenancy. 1 tenancy : N assignments;
/// a Carpark has at most one status="active" assignment at a time.
///
/// DB-level uniqueness: partial unique index `CarparkAssignment_carparkId_active_key`
/// (`carparkId` WHERE status='active') was created in migration
/// 20260630000002_carpark_assignment_active_unique. Prisma 7 cannot express
/// partial unique indexes in @@unique, so it lives only in the migration SQL.
model CarparkAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  carparkId      String    @db.Uuid
  tenancyId      String    @db.Uuid // the renter's ROOM tenancy (the cross-unit link)
  monthlyCharge  Decimal   @db.Decimal(12, 2) // prefilled from Carpark.monthlyRate, editable
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  status         String    @default("active") // "active" | "ended"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carpark      Carpark      @relation(fields: [carparkId], references: [id], onDelete: Restrict)
  tenancy      Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([organizationId, carparkId, status])
  @@index([organizationId, tenancyId, status])
}

model UnitAttribute {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  unitId         String @db.Uuid
  attributeKey   String
  attributeValue String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Listing      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([organizationId, unitId, attributeKey])
}

model Party {
  id                       String    @id @default(uuid()) @db.Uuid
  organizationId           String    @db.Uuid
  partyType                String
  displayName              String
  legalName                String?
  primaryEmail             String?
  primaryPhone             String?
  /// E.164 phone number for WhatsApp delivery. Optional — parties without
  /// a number simply don't receive WhatsApp notifications. Distinct from
  /// `primaryPhone` (which may be a landline or WhatsApp-incapable number).
  whatsappPhone            String?
  /// User toggle for receiving claim-submit notifications. Default true.
  /// Flipped to false on STOP keyword via WhatsApp.
  notifyOnNewClaim         Boolean   @default(true)
  status                   String
  idType                   String?
  idNumber                 String?
  /// Generated STORED column (migration 20260706120000). Read-only; never set
  /// in app code -- Postgres rejects direct writes (SQLSTATE 428C9). Mirrors
  /// normalizeIc() in apps/api/src/lib/normalize-ic.ts exactly. NOTE: a NULL
  /// or separator-only idNumber normalizes to '' (empty string), not NULL --
  /// callers matching on this column MUST guard against an empty/blank
  /// normalized search key, or they will match every ID-less Party.
  /// DB-GENERATED (STORED) -- Prisma cannot model this. If `prisma migrate
  /// dev` ever proposes an ALTER that DROPs the generated expression on this
  /// column, DISCARD that hunk: dropping it silently converts the column to
  /// a plain nullable column, breaking NRIC matching. This column is only
  /// ever set by the DB.
  /// LOCALE NOTE: the STRIP step's [A-Za-z0-9] bracket-range match is also
  /// collation-dependent -- benign on this DB's target locale (en_US.UTF-8);
  /// a future locale re-provision could change which characters get stripped.
  idNumberNormalized       String?
  nationality              String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  employerName             String?
  employerAddress          String?
  monthlyIncome            Decimal?  @db.Decimal(12, 2)
  race                     String?
  gender                   String?
  dateOfBirth              DateTime?
  occupation               String?
  bankName                 String?
  bankAccountHolder        String?
  bankAccountNumber        String?
  isBlacklisted            Boolean   @default(false)
  blacklistReason          String?
  // agentLevel — tier within the agent population.
  //   Values: 'leader' | 'pre_leader' | 'new_agent'
  //   UI labels: 'leader' is shown as "Manager" (see
  //   apps/web/src/pages/parties/agent-tree-view.tsx → LEVEL_LABELS).
  //   DO NOT rename the enum values: AgentTierMapping and AgentLevelThreshold
  //   key on these exact strings for commission percentage lookups.
  //   Separation of "Manager" vs "Agent" in the UI is enforced at the API
  //   boundary via GET /parties/agents?excludeLevel=leader and /parties/managers
  //   (NOT by moving managers into a separate table — Single Table Inheritance
  //   is correct here since the columns are identical).
  agentLevel               String?
  // uplineId — self-referencing reporting line. Agents with uplineId=NULL are
  // roots in the organization tree; the UI renders them hanging off a synthetic
  // "Organization" node. Storage is adjacency-list (cheap writes, good
  // read-perf with @@index below) + recursive CTE for ancestor/descendant
  // walks. Defensive depth/row caps live in parties.repository.ts.
  uplineId                 String?   @db.Uuid
  photoKey                 String?
  activeCardVersionId      String?   @unique @db.Uuid
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  activeCardVersion   AgentCardVersion?        @relation("PartyActiveCard", fields: [activeCardVersionId], references: [id], onDelete: SetNull)
  cardVersions        AgentCardVersion[]       @relation("PartyAllCards")
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  upline              Party?                   @relation("PartyHierarchy", fields: [uplineId], references: [id], onDelete: SetNull)
  downlines           Party[]                  @relation("PartyHierarchy")
  tenancies           Tenancy[]                @relation("TenancyParty")
  roles               PartyRole[]
  charges             Charge[]
  payments            Payment[]
  bills               CommissionBill[]
  cashMovements       CashMovement[]
  landlordTenancies   LandlordTenancy[]
  userAccount         User?
  deposits            Deposit[]
  commissionClaims    CommissionClaim[]        @relation("CommissionClaimAgent")
  unitInChargeFor     Listing[]                @relation("UnitInCharge")
  unitSourcedListings Listing[]                @relation("UnitSourcingAgent")
  ownedUnits          Listing[]                @relation("UnitOwner")
  ownedCarparks       Carpark[]                @relation("CarparkOwner")
  visibilityGrants    ListingVisibilityGrant[]
  notifications       NotificationLog[]
  pendingUploads      PendingUpload[]

  // Sales Entry + Renovation Claim
  salesUnitsOwned       SalesUnit[]            @relation("SalesUnitOwner")
  salesUnitsAgent       SalesUnit[]            @relation("SalesUnitAgent")
  salesUnitsInCharge    SalesUnit[]            @relation("SalesUnitInCharge")
  renovationClaimSplits RenovationClaimSplit[]
  salesClaimSplits      SalesClaimSplit[]

  issuedReservations      UnitReservation[] @relation("ReservationIssuer")
  reservationsCreatedFrom UnitReservation[] @relation("ReservationTenant")

  unitSubmissionsAsSourcer     UnitSubmission[]     @relation("UnitSubmissionSourcingAgent")
  propertySubmissionsAsSourcer PropertySubmission[] @relation("PropertySubmissionSourcingAgent")

  invoicesAsBillTo     Invoice[]             @relation("InvoiceBillTo")
  invoicesAsOwner      Invoice[]             @relation("InvoiceOwner")
  managementFeeConfigs ManagementFeeConfig[] @relation("MgmtFeeOwner")
  deviceTokens         DeviceToken[]

  @@index([organizationId, status])
  @@index([organizationId, partyType])
  @@index([organizationId, displayName])
  @@index([organizationId, agentLevel])
  @@index([organizationId, uplineId])
  @@index([organizationId, primaryPhone]) // M1 phone-search-to-act
  @@index([organizationId, idNumberNormalized], map: "party_idnum_norm")
}

