  reconfirmCount Int       @default(0)

  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party          Party        @relation("PartyAllCards", fields: [partyId], references: [id], onDelete: Cascade)
  submittedBy    User         @relation("CardVersionSubmitter", fields: [submittedById], references: [id])
  reviewedBy     User?        @relation("CardVersionReviewer", fields: [reviewedById], references: [id])
  activeForParty Party?       @relation("PartyActiveCard")

  @@index([organizationId, status])
  @@index([partyId, status])
  @@index([publicToken])
  @@index([status, expiresAt])
  @@index([reviewedById])
  @@index([submittedById])
}

model UnitReservation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  referenceCode  String
  status         String @default("pending_customer")

  issuedByPartyId String   @db.Uuid
  issuedAt        DateTime @default(now())
  expiresAt       DateTime
  publicToken     String   @unique

  propertyId      String    @db.Uuid
  unitId          String    @db.Uuid
  carPark         String?
  proposedMoveIn  DateTime
  proposedMoveOut DateTime?
  specialRemarks  String?

  reservationDeposit Decimal  @db.Decimal(12, 2)
  documentationFee   Decimal  @db.Decimal(12, 2)
  rentalDeposit      Decimal  @db.Decimal(12, 2)
  utilityDeposit     Decimal  @db.Decimal(12, 2)
  accessCardDeposit  Decimal  @db.Decimal(12, 2)
  agreedMonthlyRent  Decimal? @db.Decimal(12, 2)

  applicantFullName String?
  applicantNric     String?
  applicantContact  String?
  applicantEmail    String?

  applicantAddressLine1 String?
  applicantAddressLine2 String?
  applicantCity         String?
  applicantPostcode     String?
  applicantState        String?
  applicantCountry      String?

  signedAt                   DateTime?
  signedFromIp               String?
  signedUserAgent            String?
  signatureDrawingKey        String?
  signatureTypedName         String?
  signatureAgreementTickedAt DateTime?

  signedPdfKey String?

  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  // Per-reservation T&C list. Empty array = "use the bundled defaults
  // unchanged"; non-empty = "use this list verbatim, in order, ignoring
  // defaults". needsApproval is purely structural: customTerms.length > 0.
  customTerms           String[]  @default([])
  // Legacy split (predecessor of customTerms). Kept on the row for back-
  // compat reads of historical reservations; no new flow writes them.
  disabledClauseIndexes Int[]     @default([])
  termsAddendum         String?
  approvalReviewedAt    DateTime?
  approvalReviewedById  String?   @db.Uuid
  approvalNote          String?

  // Set once when an admin creates a tenant FROM this signed reservation
  // (conditional write, WHERE tenantPartyId IS NULL). Drives the "has
  // reservation" tag. Distinct relation name from ReservationIssuer above.
  tenantPartyId String? @db.Uuid

  // Applicant identity/profile captured on the customer fill form (Section B).
  // Nullable + additive; carried into Party at tenant creation from reservation.
  nationality              String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  monthlyIncome            Decimal? @db.Decimal(12, 2)
  occupation               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  // Restrict made explicit (was implicit Prisma default). A Listing with any
  // reservation row must not be deleted; application code blocks first,
  // this FK action is the safety net.
  unit         Listing                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  issuedBy     Party                       @relation("ReservationIssuer", fields: [issuedByPartyId], references: [id])
  tenantParty  Party?                      @relation("ReservationTenant", fields: [tenantPartyId], references: [id], onDelete: SetNull)
  transitions  UnitReservationTransition[]
  documents    UnitReservationDocument[]
  tenancy      Tenancy?

  @@unique([organizationId, referenceCode])
  @@index([organizationId, status])
  @@index([organizationId, issuedByPartyId])
  @@index([organizationId, tenantPartyId], map: "unitreservation_tenantparty")
  @@index([expiresAt])
  @@index([propertyId])
  @@index([unitId])
}

model UnitReservationTransition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  reservationId  String   @db.Uuid
  fromStatus     String?
  toStatus       String
  actor          String
  changedAt      DateTime @default(now())
  note           String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation  UnitReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, changedAt])
  @@index([organizationId])
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  invoiceNumber   String
  partyId         String    @db.Uuid
  ownerPartyId    String?   @db.Uuid
  tenancyId       String?   @db.Uuid
  propertyId      String?   @db.Uuid
  apartmentId     String?   @db.Uuid // owner_statement per-unit scope; null = legacy owner-combined
  invoiceType     String // "tenant_rental" | "tenant_aircon" | "owner_statement"
  status          String    @default("draft") // draft → approved → sent → paid | void
  invoiceDate     DateTime
  dueDate         DateTime?
  periodMonth     DateTime? // first-of-month billing period (M5 queue filter; never parse from idempotencyKey)
  totalAmount     Decimal   @db.Decimal(12, 2)
  sstAmount       Decimal?  @db.Decimal(12, 2)
  currency        String    @default("MYR") // 2026-06-11 gap pass — Charge/Payment/ChargeTemplate all carry currency
  pdfKey          String?
  // M6 statement-level bulk receipts
  attachmentKeys  String[]  @default([])
  // M5 draft dedupe: "draft:<tenancyId>:<periodMonth>"; M3 payment-create dedupe
  idempotencyKey  String?
  approvedBy      String?   @db.Uuid // User.id (admin actor) — plain column, no FK
  approvedAt      DateTime?
  // Accounting-doc redesign P1 (2026-07-23): human-facing sequential DISPLAY number
  // for an owner_statement Invoice, e.g. "OST-0001" — minted from the OST
  // DocumentSeries (mintDocumentNumberTx) at the draft→approved transition
  // (owner-billing.service.ts's approveStatementService), gated behind
  // ENABLE_OWNER_DOC_NUMBERING. NEVER the dedupe/identity key — that stays
  // `invoiceNumber`'s "OS-<mm>-<owner8>[-<apt8>]" slug, untouched. Additive +
  // nullable: flag off, or any non-owner_statement Invoice, leaves this null.
  statementNumber String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party        Party        @relation("InvoiceBillTo", fields: [partyId], references: [id], onDelete: Cascade)
  ownerParty   Party?       @relation("InvoiceOwner", fields: [ownerPartyId], references: [id], onDelete: SetNull)
  tenancy      Tenancy?     @relation(fields: [tenancyId], references: [id], onDelete: SetNull)
  charges      Charge[]

  @@unique([organizationId, invoiceNumber])
  // Postgres treats NULLs as distinct — multiple NULL idempotencyKeys allowed
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, ownerPartyId])
  @@index([organizationId, tenancyId])
  @@index([organizationId, periodMonth])
  @@index([organizationId, apartmentId])
  @@index([partyId])
}

model AircondMeter {
