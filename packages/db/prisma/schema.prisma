// ─── Sales Entry & Renovation Claim (Wave 1) ────────────────────────────────
//
// Off-plan project lifecycle: Project → SalesUnit → RenovationProgress →
// (auto-promote to Unit on completion when purpose=rent). Renovation Claims
// and Sales Claims live alongside, with their own 5-state machine.
// See docs/plans/sales-entry-and-renovation-claim.md sections 3, 6, 7, 8.

model Project {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  name               String
  developer          String
  city               String?
  expectedHandover   DateTime?
  status             String    @default("unverified") // unverified | active | archived
  verifiedAt         DateTime?
  verifiedById       String?   @db.Uuid
  // First-time promotion auto-creates a Property and writes its id back here.
  promotedPropertyId String?   @unique @db.Uuid
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?   @db.Uuid

  organization        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotedProperty    Property?                       @relation(fields: [promotedPropertyId], references: [id], onDelete: SetNull)
  salesUnits          SalesUnit[]
  verifiedTransitions ProjectVerificationTransition[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model SalesUnit {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  projectId       String   @db.Uuid
  unitNumber      String
  ownerPartyId    String   @db.Uuid
  salesDate       DateTime
  purpose         String // "rent" | "own_stay"
  bedrooms        Int // -1 (=Studio), 1..3, 4 (=4+)
  bathrooms       Int // 1, 2, 3 (=3+)
  parkingLots     Int      @default(0)
  expectedRental  Decimal? @db.Decimal(12, 2)
  purchasePrice   Decimal  @db.Decimal(14, 2)
  agentPartyId    String   @db.Uuid // submitter
  inChargePartyId String?  @db.Uuid // becomes agent on Source-Queue approval

  // Source-queue lifecycle
  sourceFlag           String    @default("AGENT_SOURCED") // "COMPANY" | "AGENT_SOURCED"
  sourcingApproved     Boolean   @default(false)
  sourcingApprovedById String?   @db.Uuid
  sourcingApprovedAt   DateTime?
  amendmentNotes       String?
  // Soft-delete flag for an agent's withdrawn pending submission. Row
  // stays for audit; queries that drive the source queue add
  // sourcingCancelled=false. Mirror of Unit.sourcingCancelled.
  sourcingCancelled    Boolean   @default(false)

  // Promotion linkage (one-way; null until auto-promoted)
  promotedUnitId String? @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  ownerParty         Party               @relation("SalesUnitOwner", fields: [ownerPartyId], references: [id])
  agentParty         Party               @relation("SalesUnitAgent", fields: [agentPartyId], references: [id])
  inChargeParty      Party?              @relation("SalesUnitInCharge", fields: [inChargePartyId], references: [id])
  promotedUnit       Listing?            @relation("SalesUnitPromotedUnit", fields: [promotedUnitId], references: [id], onDelete: SetNull)
  // Inverse of Listing.salesUnitOrigin (the auto-promote back-pointer column on Listing).
  originatedUnit     Listing?            @relation("UnitSalesUnitOrigin")
  renovationProgress RenovationProgress?
  renovationClaims   RenovationClaim[]
  salesClaims        SalesClaim[]

  @@unique([organizationId, projectId, unitNumber])
  @@index([organizationId, agentPartyId])
  @@index([organizationId, sourcingApproved])
  @@index([organizationId, salesDate])
  @@index([inChargePartyId])
  @@index([ownerPartyId])
}

