// ── Accounting documents core (2026-07-02 spec §4.1) ─────────────────────────
// The immutable legal layer. After issue: no edit, no regenerate, no delete —
// status transitions only (issued → partially_settled → settled, or → offset
// when CNs cover the full amount). Corrections are always NEW linked documents.
// seriesId / partyId / tenancyId / propertyId / apartmentId / listingId /
// issuedById / originalDocumentId / statementInvoiceId are PLAIN columns
// (no FK sprawl); apartment/listing/property are denormalized so unit-first
// views are free.
model BillingDocument {
  id                         String    @id @default(uuid()) @db.Uuid
  organizationId             String    @db.Uuid
  docType                    String // "invoice" | "debit_note" | "credit_note" | "refund_note"
  documentNumber             String // series-minted, e.g. "IVTEN-0001" / "DEP-2026-0007"
  seriesId                   String    @db.Uuid // → DocumentSeries (plain column)
  status                     String    @default("issued") // issued | partially_settled | settled | offset
  issuedAt                   DateTime  @default(now())
  issuedById                 String    @db.Uuid // User.id — plain column
  billingMonth               DateTime? @db.Date // first-of-month; null for month-less docs
  counterpartyType           String // "tenant" | "owner"
  partyId                    String    @db.Uuid // → Party (plain column)
  tenancyId                  String?   @db.Uuid
  propertyId                 String?   @db.Uuid
  apartmentId                String?   @db.Uuid
  listingId                  String?   @db.Uuid
  originalDocumentId         String?   @db.Uuid // MANDATORY for credit_note/refund_note (LHDN original ref)
  statementInvoiceId         String?   @db.Uuid // → Invoice (owner_statement) for IVOWN docs + statement CNs
  creditAmount               Decimal?  @db.Decimal(12, 2) // credit_note only: collected portion = spendable credit
  reason                     String? // CN/RN: the void/refund reason
  subtotal                   Decimal   @db.Decimal(12, 2)
  sstAmount                  Decimal   @default(0) @db.Decimal(12, 2)
  total                      Decimal   @db.Decimal(12, 2)
  pdfKey                     String?
  idempotencyKey             String?
  paymentId                  String?   @db.Uuid // → Payment (plain column) — links a receipt to its Payment (P2 R13)
  documentStatus             String    @default("ISSUED") // DRAFT | ISSUED | CANCELLED | SUPERSEDED (R6)
  settlementStatus           String    @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID | OVERPAID (derived, R7)
  taxStatus                  String    @default("NOT_REQUIRED") // NOT_REQUIRED | NOT_SUBMITTED | SUBMITTED | VALID | INVALID | CANCELLED (column only; Phase 3)
  supersededByDocumentId     String?   @db.Uuid // set on a cancel-and-replaced original → its replacement (plain column, R3)
  /// Proforma spec R3 (2026-08-10). Set on a GRADUATED `invoice` → the `proforma` whose
  /// lines it was minted from. Null on every other document, including the proforma itself.
  ///
  /// ⚠️ `originalDocumentId` MUST NOT be reused for this link. Four paths treat
  /// `originalDocumentId: null` as the "this is a real original / head of chain" sentinel
  /// (charge-adjustment.service.ts:167, credit-notes.service.ts:452,
  /// correction-replace.service.ts:87, bills-grid/service.ts:564). A graduated invoice
  /// carrying a non-null originalDocumentId becomes invisible to all four — a credit note
  /// against it throws ORIGINAL_DOCUMENT_NOT_FOUND and the grid goes provenance-blind,
  /// which double-bills. That column stays reserved for the CN/RN LHDN original reference.
  ///
  /// Also the immutability marker (R5): a document with this set is a real tax invoice
  /// against real money and can NEVER enter the grid's reclaimable set.
  proformaDocumentId         String?   @db.Uuid
  // Spec 1 rent-reclassification (Phase 1) — additive, nullable. docType stays the accounting
  // form; commercialDocumentType is the business purpose; ledgerTreatment is the money fate.
  commercialDocumentType     String? // RENTAL_INVOICE|OWNER_COLLECTION_INVOICE|TENANT_SERVICE_INVOICE|OWNER_SERVICE_INVOICE
  ledgerTreatment            String? // PAYABLE_TO_OWNER|MANAGER_REVENUE
  principalOwnerId           String?   @db.Uuid
  collectedOnBehalfOfOwnerId String?   @db.Uuid
  ownerRefDiffersReason      String?
  legacyClassification       String? // e.g. LEGACY_RENT_MISCLASSIFICATION (Phase-3 migration only)
  meta                       Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines              BillingDocumentLine[]
  creditApplications CreditApplication[]
  refunds            Refund[]

  @@unique([organizationId, documentNumber])
  // Postgres: NULLs distinct — multiple NULL idempotencyKeys allowed
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, apartmentId, billingMonth])
  @@index([organizationId, partyId, docType])
  @@index([organizationId, docType, status])
  @@index([organizationId, originalDocumentId])
  @@index([organizationId, paymentId])
  @@index([organizationId, documentStatus])
  @@index([organizationId, settlementStatus])
  @@index([organizationId, proformaDocumentId])
}

model BillingDocumentLine {
  id          String  @id @default(uuid()) @db.Uuid
  documentId  String  @db.Uuid
  chargeId    String? @db.Uuid // → Charge (nullable: overpayment-CN lines settle no charge; R12a)
  categoryId  String? @db.Uuid // → ChargeCategory (nullable: overpayment-CN lines have no category; R12a)
  description String
  amount      Decimal @db.Decimal(12, 2)
  sstRate     Decimal @default(0) @db.Decimal(5, 2)
  sstAmount   Decimal @default(0) @db.Decimal(12, 2)
  // This line's `amount` IS tax its SIBLING line already contributed via that
  // line's own `sstRate` — so it is excluded from `subtotal` at mint
  // (issue.service.ts) and folded away by every human-facing renderer
  // (foldTaxLines, @kason/shared). The line still EXISTS, carrying its own
  // chargeId, because that is what makes the tax visible to deriveDocumentStatus
  // and allocatable on the Record-Payment form — without it the tax is invoiced,
  // owed and declared to LHDN yet has no row a payment can settle.
  //
  // The write side has always KNOWN this (IssueLineInput.isTax); it simply never
  // persisted it, so readers could not tell a tax line from a real one and printed
  // it as a third line item that made the Amount column refuse to foot to Subtotal.
  isTax       Boolean @default(false)

  document BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chargeId])
}

// P3 (spec §4.1): one row per CN-credit application. The applied Payment
// (method 'credit_note') + its PaymentAllocations ARE the money movement —
// this table only links payment → credit document for balance derivation:
// CN unapplied balance = creditAmount − Σ(linked payments' amounts).
model CreditApplication {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  creditDocumentId String   @db.Uuid // → BillingDocument (docType credit_note)
  paymentId        String   @db.Uuid // → Payment (method credit_note)
  appliedAt        DateTime @default(now())
  appliedById      String   @db.Uuid // User.id — plain column (matches approvedBy idiom)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditDocument BillingDocument @relation(fields: [creditDocumentId], references: [id], onDelete: Restrict)
  payment        Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId])
  @@index([organizationId, creditDocumentId])
}

// P3 (spec §4.1): money physically returned to the payer. The RN (BillingDocument
// docType refund_note) is the legal artifact; this row carries the operational
// details (method, bank ref, slip). FPX gateway payments are NEVER reversed —
// refunds are recorded manually (spec §3).
model Refund {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  refundNoteDocumentId String   @db.Uuid // → BillingDocument (docType refund_note)
  originalPaymentId    String   @db.Uuid // → Payment that collected the money
  amount               Decimal  @db.Decimal(12, 2)
  method               String
  bankRef              String?
  proofKey             String? // storage key of the transfer slip
  refundedAt           DateTime
  recordedById         String   @db.Uuid // User.id — plain column
  createdAt            DateTime @default(now())

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refundNoteDocument BillingDocument @relation(fields: [refundNoteDocumentId], references: [id], onDelete: Restrict)
  originalPayment    Payment         @relation(fields: [originalPaymentId], references: [id], onDelete: Restrict)

  @@index([organizationId, refundNoteDocumentId])
  @@index([originalPaymentId])
}

// ── Accounting-document redesign P3 (2026-07-22): internal Expense (EXP-) ─────
// A supplier/property cost recorded ONCE, then ALLOCATED across who ultimately
// bears it (SupplierExpenseAllocation.borneBy ∈ tenant|owner|kaen). The UI
// "Shared" case = >1 allocation with different bearers. Purely additive — no
// existing table is touched. Downstream fate wiring (EB- / owner-ledger / KAEN
// opex) lands in P4/P5/P6; recoveryStatus carries that lifecycle.
model SupplierExpense {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @db.Uuid
  expenseNumber       String // EXP- series-minted, e.g. "EXP-0001"
  supplierName        String
  supplierRef         String? // supplier invoice / bill reference
  expenseDate         DateTime  @db.Date
  totalAmount         Decimal   @db.Decimal(12, 2)
  propertyId          String?   @db.Uuid // plain column (denormalised search)
  apartmentId         String?   @db.Uuid
  unitId              String?   @db.Uuid // → Listing (the room); plain column
  description         String?
  paymentSource       String    @default("company_bank") // company_bank | employee_advance | supplier_credit
  claimantName        String?
  costPurpose         String    @default("unit_specific") // unit_specific | shared_materials | company_overhead
  approvalStatus      String    @default("approved") // submitted | approved | rejected
  reimbursementStatus String    @default("not_applicable") // not_applicable | awaiting_reimbursement | partial | paid
  approvedById        String?   @db.Uuid
  approvedAt          DateTime?
  notes               String?
  status              String    @default("recorded") // recorded | void
  createdById         String    @db.Uuid // User.id — plain column
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allocations         SupplierExpenseAllocation[]
  costAssignments     SupplierExpenseCostAssignment[]
  bankCostAllocations BankCostAllocation[]

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, expenseDate])
  @@index([organizationId, apartmentId])
}

model SupplierExpenseAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  supplierExpenseId String   @db.Uuid
  borneBy           String // "tenant" | "owner" | "kaen" (BORNE_BY)
  amount            Decimal  @db.Decimal(12, 2)
  partyId           String?  @db.Uuid // concrete party for tenant/owner; null for kaen
  tenancyId         String?  @db.Uuid
  chargeCategoryId  String?  @db.Uuid
  description       String?
  // Downstream lifecycle: pending → routed (EB-/owner-ledger/kaen-opex minted) →
  // settled. The routed artifact's id is stamped in P4/P5/P6 (additive columns then).
  recoveryStatus    String   @default("pending") // pending | routed | settled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierExpense       SupplierExpense        @relation(fields: [supplierExpenseId], references: [id], onDelete: Cascade)
  // P6 back-relation — at most one per allocation in practice (organizationId +
  // sourceExpenseAllocationId is unique on KaenOperatingExpense below), modelled as a
  // list because sourceExpenseAllocationId alone isn't a single-column unique key.
  kaenOperatingExpenses KaenOperatingExpense[]

  @@index([organizationId, supplierExpenseId])
  @@index([organizationId, borneBy, recoveryStatus])
}

// Accounting-document redesign P6 — the KAEN agency's OWN operating-expense ledger
// (software subscriptions, office rent, bank charges, etc.) — NEVER owner/tenant money.
// One row per borneBy:"kaen" SupplierExpenseAllocation, created by
// createSupplierExpenseService when ENABLE_KAEN_OPEX is on (expenses.service.ts). The
// unique index below is the idempotency guard: re-attempting the routing step for the
// same allocation (a retry, a repair script) never duplicates a row.
model KaenOperatingExpense {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @db.Uuid
  sourceExpenseAllocationId String   @db.Uuid // provenance — the borneBy:"kaen" allocation this row was routed from
  category                  String // resolved from the allocation's ChargeCategory.name, else "other_expense"
  description               String?
  amount                    Decimal  @db.Decimal(12, 2)
  expenseDate               DateTime @db.Date
  status                    String   @default("recorded") // recorded | void
  createdById               String   @db.Uuid // User.id — plain column
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization            Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict (not Cascade): SupplierExpense/Allocation never hard-delete today (soft
  // status "recorded"|"void" only) — if a hard-delete path is ever added, it must NOT
  // silently vaporize agency P&L history; force a deliberate decision at that point.
  sourceExpenseAllocation SupplierExpenseAllocation @relation(fields: [sourceExpenseAllocationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceExpenseAllocationId])
  @@index([organizationId, expenseDate])
  @@index([organizationId, category])
}

// Accounting-document redesign P7 (reshaped, 2026-07-23) — Owner Funding Request:
// a DELIBERATE admin-issued ask for the owner to fund KAEN (e.g. a big repair far
// exceeds the rent collected this month). NOT a BillingDocument / invoice /
// debit_note / receivable — KAEN is not EARNING this money, it is asking the
// owner to send money IN. The already-carried-forward negative owner running
// balance stays silent + automatic (computeOwnerRunningBalance /
// computeAvailableOwnerPayableC / derivePeriodRemittanceStatus and all payout
// math are UNCHANGED by this table) — this row exists only when an admin
// explicitly decides KAEN needs the owner to pay NOW. amount/reason are
// admin-SUPPLIED (deliberate), never auto-computed.
model OwnerFundingRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  ownerPartyId   String    @db.Uuid // plain column — mirrors OwnerLedgerEntry.ownerPartyId, no FK
  propertyId     String?   @db.Uuid // plain column; null = not attributable to one property
  amount         Decimal   @db.Decimal(12, 2) // admin-supplied, never computed
  reason         String
  status         String    @default("requested") // requested | settled | cancelled
  requestedById  String    @db.Uuid // User.id — plain column (User idiom, mirrors SupplierExpense.createdById)
  settledAt      DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, ownerPartyId, status])
}

model AgentCardVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  partyId        String @db.Uuid

  displayName  String
  title        String
  primaryEmail String?
  primaryPhone String?

  status          String
  submittedById   String    @db.Uuid
  submittedByType String
