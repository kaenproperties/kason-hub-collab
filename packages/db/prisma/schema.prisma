model DraftConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  runDayOfMonth      Int      @default(25)
  /// Whole months AHEAD of the RUN month that a run bills. 1 = KAEN's process
  /// (run on the 25th, draft the COMING month's rent); 0 = draft the run month
  /// itself (the pre-2026-07 behaviour). Range 0..2, enforced by the zod schema
  /// and the CHECK constraint in the migration.
  ///
  /// Applied by the CALLERS of runAutoDraftInvoices (the cron + "Run now"), never
  /// inside it — that function still drafts exactly the period it is handed, so
  /// its CRITICAL-risk call graph is untouched by advance billing.
  ///
  /// Only rent/carpark (facts knowable in advance) are drafted this way. Metered
  /// utilities keep billService's blocked_future_period guard: you cannot read
  /// August's meter in July.
  billPeriodOffset   Int      @default(1)
  dueDayOffset       Int?
  includeRent        Boolean  @default(true)
  // DEPRECATED (2026-06-27): no longer drives auto-draft folding. Under the one-action
  // "Post charges" flow, tenant utility/aircond charges are standalone POSTED charges, so
  // the auto-draft cron no longer bundles them onto the rent invoice. Column retained for
  // additive-safety (do NOT drop); it persists an inert flag with no behavioral effect.
  includeElectricity Boolean  @default(true)
  includeMgmtFee     Boolean  @default(true)
  includeCleaning    Boolean  @default(true)
  /// DEAD (never read by any code path). Kept only so the column is not dropped.
  /// This was NEVER the auto-billing switch — it would have meant "approve a draft
  /// the instant it is created", which no surface ever wanted. Scheduled
  /// auto-billing is `autoBillDayOfMonth` below; look there, not here.
  autoApprove        Boolean  @default(false)
  /// Day of month (1–28) on which this org's DRAFT rental invoices are BILLED
  /// automatically: invoice draft→approved, charges draft→posted (live
  /// receivables), documents issued, owner ledger synced, tenant sees it payable.
  ///
  /// NULL (the default) = OFF — drafts wait for a human to issue them from the
  /// approvals queue. Setting it is an explicit, per-org opt-out of that gate,
  /// so an org that never touches this setting keeps today's behaviour exactly.
  ///
  /// Scope is deliberately bounded on BOTH ends (see auto-bill.service.ts):
  /// only `tenant_rental` invoices, and only periods from the CURRENT month
  /// through the org's draft target month. A past-month draft is never billed
  /// automatically — the mirror of the drafting side, which never reaches back
  /// into a period an owner statement may already have frozen.
  autoBillDayOfMonth Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId]) // per-org singleton (v1)
}

