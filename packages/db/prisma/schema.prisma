// ── Phase-2 M2: Unit Utility Billing (amendment 2026-06-18) ──────────────────
model UnitUtilityBill {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @db.Uuid
  apartmentId              String   @db.Uuid
  periodMonth              DateTime @db.Date
  billingMode              String // snapshot: "whole" | "subsidy" | "no_subsidy"
  tnbTotal                 Decimal  @db.Decimal(12, 2)
  airSelangor              Decimal  @default(0) @db.Decimal(12, 2)
  indahWater               Decimal  @default(0) @db.Decimal(12, 2)
  cleaning                 Decimal  @default(0) @db.Decimal(12, 2)
  wifi                     Decimal? @db.Decimal(12, 2)
  // Per-bill bearer for each non-electricity utility: "owner" (default — out of
  // the tenant pool) or "tenant" (pooled per-pax). TNB + AirSelangor are always tenant.
  // DB-ENFORCED: CHECK "UnitUtilityBill_indahWaterBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  indahWaterBearer         String   @default("owner")
  // DB-ENFORCED: CHECK "UnitUtilityBill_cleaningBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  cleaningBearer           String   @default("owner")
  // DB-ENFORCED: CHECK "UnitUtilityBill_wifiBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  wifiBearer               String   @default("owner")
  ownerAttributableAircond Decimal? @db.Decimal(12, 2)
  ownerBorneUtilities      Decimal? @db.Decimal(12, 2) // Σ owner-borne indah/cleaning/wifi (left out of the tenant pool)
  subsidyPerPax            Decimal? @db.Decimal(12, 2) // snapshot of the rate used
  /// Frozen policy discriminator for this bill. Null denotes a legacy bill
  /// created before policy snapshots existed.
  subsidyPolicySnapshot    String?
  /// Frozen per-unit monthly TNB cap when subsidyPolicySnapshot selects the
  /// unit-cap policy; null for legacy per-pax/no-subsidy bills.
  tnbSubsidyCapSnapshot    Decimal? @db.Decimal(12, 2)
  subsidyCovered           Decimal? @db.Decimal(12, 2) // owner-paid subsidy total
  ownerBorneUtilitiesTotal Decimal? @db.Decimal(12, 2) // = ownerAttributableAircond + ownerBorneUtilities + subsidyCovered + roundingResidual (seam for M6)
  roundingResidual         Decimal? @db.Decimal(12, 2)
  status                   String   @default("draft") // draft → charged | void
  notes                    String?
  createdBy                String   @db.Uuid // User.id — plain column (no FK)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartment    Apartment                   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  allocations  UtilityAllocation[]
  attachments  UnitUtilityBillAttachment[]

  @@unique([organizationId, apartmentId, periodMonth])
  @@index([organizationId, status])
  @@index([organizationId, periodMonth])
}

model UnitUtilityBillAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  billId         String   @db.Uuid
  storageKey     String // utility-bills/<apartmentId>/<uuid>.<ext>
  filename       String // original upload name (display)
  uploadedById   String   @db.Uuid // User.id — plain column (no FK), matches UnitUtilityBill.createdBy
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bill         UnitUtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([organizationId, billId])
}

model UtilityAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  billId           String   @db.Uuid
  unitId           String   @db.Uuid
  tenancyId        String   @db.Uuid
  partyId          String   @db.Uuid // bill-to party snapshot — plain column (no FK)
  pax              Int
  tnbShare         Decimal  @db.Decimal(12, 2)
  airSelangorShare Decimal  @db.Decimal(12, 2)
  indahShare       Decimal  @db.Decimal(12, 2)
  cleaningShare    Decimal  @db.Decimal(12, 2)
  wifiShare        Decimal  @default(0) @db.Decimal(12, 2)
  subsidyDeduction Decimal  @default(0) @db.Decimal(12, 2)
  computedAmount   Decimal  @db.Decimal(12, 2)
  chargeId         String?  @db.Uuid // plain column (no FK)
  status           String   @default("submitted") // submitted → charged | void
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bill         UnitUtilityBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  unit         Listing         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenancy      Tenancy         @relation(fields: [tenancyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, billId, unitId])
  @@index([organizationId, billId])
  @@index([tenancyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Bills & Expenses Grid — STANDALONE store (spec 2026-07-10).
// HARD CONSTRAINT: nothing here writes Charge / OwnerLedgerEntry /
// UnitUtilityBill / UtilityAllocation. A future accounting system links them.
// Period column is `periodMonth DateTime @db.Date` on the FOUR period-scoped
// tables (Entry / MeterReading / Expense / Attachment; the spec mixed
// periodMonth/billingMonth — normalised here). UnitBillsBearerConfig is
// per-apartment config keyed @@unique([organizationId, apartmentId]), NOT
// period-scoped, so it deliberately has NO periodMonth — do NOT add one (it
// would change the config's cardinality). Mirrors UnitUtilityBill
// (Apartment-keyed, @db.Date) — NOT MeterReading (Listing-keyed, bare DateTime).
// Enums are String columns; no Prisma `enum` type is used in this schema.
// USER RULING 2026-07-10: no status/void column on Entry, MeterReading, or
// BearerConfig. Only GridExpense retires (active|void). GridAttachment hard-deletes.
// ─────────────────────────────────────────────────────────────────────────────

model UnitBillsGridEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  apartmentId    String   @db.Uuid
  periodMonth    DateTime @db.Date // 1st-of-month, matches UnitUtilityBill.periodMonth

  readingDate DateTime? @db.Date // per-apartment billing day-of-month

  rental Decimal? @db.Decimal(12, 2) // whole-unit rent; NULL when room-grained

  cleaning       Decimal? @db.Decimal(12, 2)
  // DB-ENFORCED: CHECK "UnitBillsGridEntry_cleaningBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  cleaningBearer String   @default("owner") // "owner" | "tenant"
  // Per-charge Expense/Profit "nature" for the SCALAR cleaning charge (charge-nature-routing
  // Fix 2), sourced from the CLEANING recurring definition's effective revision. "expense" =
  // recovery of a KAEN-fronted cost → owner payout deduction / tenant Expense Bill (never KAEN
  // revenue); "profit"/null = legacy KAEN service revenue. Read only by the flag-gated mint.
  cleaningNature String? // "expense" | "profit"

  tnbTotalRaw   Decimal? @db.Decimal(12, 2) // RAW un-shaped provider bill (C3/C5). NEVER the shaped value.
  tnbPattern    String   @default("recharged") // "recharged" | "absorbed" | "tenant_direct" | "manager_advanced" (Task 4: KAEN-fronted, recovers from tenant pool)
  /// GROSS provider bill for the period — NOT net of the per-room aircond recovery.
  /// Recorded at Bill from the un-shaped `tnbTotalRaw`, never from ComputeResult (caveat C3).
  /// Worked example: totalAircond=100, tnbTotalRaw=590, absorbed => this column stores 590,
  /// while the owner's NET burden is 490 (they recover 100 via separately-billed per-room
  /// aircond charges). Any consumer computing "owner cost" MUST subtract the period's aircond
  /// charges, or it double-counts the recovery.
  ownerBorneTnb Decimal? @db.Decimal(12, 2) // derived from raw input at Bill, never from ComputeResult (C3)

  airSelangorRaw Decimal? @db.Decimal(12, 2) // AIR = Air Selangor = WATER, never air-conditioning
  airPattern     String   @default("recharged") // "recharged" | "absorbed" | "tenant_direct" | "manager_advanced" — same allowed values as tnbPattern
  /// GROSS provider bill for the period — same C3 caveat as `ownerBorneTnb`: not net of any
  /// recovery, recorded from the un-shaped `airSelangorRaw` at Bill. Subtract recoveries
  /// downstream before presenting this as an owner cost.
  ownerBorneAir  Decimal? @db.Decimal(12, 2)

  /// Frozen subsidy policy used by the first successful Bill attempt. Null on
  /// untouched/legacy rows so existing periods continue their legacy billing-mode policy.
  subsidyPolicySnapshot String?
  /// Frozen unit-level monthly TNB owner cap. Meaningful only for the unit-cap
  /// policy; null for legacy per-pax/no-subsidy rows.
  tnbSubsidyCapSnapshot Decimal? @db.Decimal(12, 2)

  wifi       Decimal? @db.Decimal(12, 2)
  // DB-ENFORCED: CHECK "UnitBillsGridEntry_wifiBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  wifiBearer String   @default("owner")
  // Per-charge Expense/Profit "nature" for the SCALAR wifi charge (charge-nature-routing Fix 2),
  // sourced from the WIFI recurring definition's effective revision. Same semantics as
  // cleaningNature above. Read only by the flag-gated mint.
  wifiNature String? // "expense" | "profit"

  maintenanceFee       Decimal? @db.Decimal(12, 2)
  // DB-ENFORCED: CHECK "UnitBillsGridEntry_maintenanceFeeBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  maintenanceFeeBearer String   @default("owner") // owner|tenant — IS a PoolComponents field as of 69fc262f (maintenance is billable)

  paymentStatus String @default("unpaid") // "unpaid"|"pending"|"partial"|"paid" — billing != payment

  billedAt     DateTime? // null = never billed; non-null = last-billed marker. NOT terminal — re-Bill supersedes (2026-07 invoice link).
  // Set when the entry has live (ISSUED) invoices; cleared/updated on supersede+reissue. Read for the grid lock/state.
  invoicedAt   DateTime?
  lockedBy     String?   @db.Uuid // User.id — plain column (no FK)
  // Task 5/8 (agency billing itemization): per-attempt counter for mintItemizedCharges'
  // chargeNumber suffix (`-r${billRevision}` when > 0, omitted at 0). 0 = first issuance
  // (original GRIDUTIL-/GRIDOWN- numbering, unchanged). Task 8's re-Bill increments this
  // BEFORE re-minting, so the fresh chargeNumber never collides with the CREDITED
  // prior-attempt charges under the unconditional @@unique([organizationId, chargeNumber])
  // on Charge. Additive, prod-safe (NOT NULL is safe here — DEFAULT 0 backfills existing rows).
  billRevision Int       @default(0)

  createdBy   String   @db.Uuid // User.id — plain column (no FK)
  updatedById String?  @db.Uuid // User.id — last admin editor; NULL = never admin-edited (plain column, no FK)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // optimistic-concurrency token

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Restrict, NOT Cascade: these are money rows — deleting an Apartment must never silently delete billed entries. Precedent: `UnitUtilityBill.apartment` (schema.prisma:2735) uses the same Restrict.
  apartment    Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  expenses       GridExpense[]
  readings       GridMeterReading[]
  attachments    GridAttachment[]
  // Charges minted by this entry's Bill. onDelete: SetNull (defined on Charge.sourceGridEntry)
  // so deleting this entry nulls the ref rather than orphaning it.
  sourcedCharges Charge[]                 @relation("GridEntrySourcedCharges")
  // Recurring-charge snapshots frozen onto THIS period (custom lines only; cleaning/wifi
  // stay scalar). Cascade — child rows die with the entry.
  recurringLines GridEntryRecurringLine[]

  @@unique([organizationId, apartmentId, periodMonth])
  @@index([organizationId, periodMonth])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, apartmentId])
}

/// Non-financial monthly admin note shown in Tenant & Owner Billing's Excel-style
/// Summary tab. Kept separate from UnitBillsGridEntry so typing a note can never
/// create a billable entry or affect Save/Bill/owner-payout state.
model BillsGridSummaryNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  apartmentId    String   @db.Uuid
  periodMonth    DateTime @db.Date
  note           String   @default("")
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, apartmentId, periodMonth])
  @@index([organizationId, periodMonth])
}

/// Manually maintained company-bank account registry. Only a masked account
/// label is stored here; credentials, balances and online-banking access never
/// enter the property-management system.
model BankReconciliationAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  bankName            String
  nickname            String
  maskedAccountNumber String?
  active              Boolean  @default(true)
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions BankReconciliationTransaction[]

  @@index([organizationId, active])
}

/// Imported/copied bank statement line. Categorisation links a real company
/// cash movement to the exact property cost/charge it funds. `fingerprint`
/// makes repeated statement uploads idempotent per account.
model BankReconciliationTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  accountId       String   @db.Uuid
  transactionDate DateTime @db.Date
  description     String
  reference       String?
  debit           Decimal  @default(0) @db.Decimal(14, 2)
  credit          Decimal  @default(0) @db.Decimal(14, 2)
  balance         Decimal? @db.Decimal(14, 2)
  source          String   @default("manual") // manual | paste | csv
  importBatchKey  String?
  fingerprint     String

  status             String    @default("unmatched") // unmatched | matched | review
  apartmentId        String?   @db.Uuid
  responsibility     String? // tenant | owner | company | pending
  collectionCategory String? // rental | deposit | tenant_expense | owner_payment | management_fee | other | pending
  transactionCategory String? // non_operational_transfer | internal_bank_transfer | null
  destinationAccount  String?
  transferPurpose      String? // payroll_funding | head_office_funding | reserve_transfer | tax_funding | other
  internalTransferPairId String? @db.Uuid
  gridExpenseId      String?   @db.Uuid
  linkedPaymentId    String?   @db.Uuid // posted tenant payment created from this bank credit
  chargeRequired     Boolean   @default(false)
  matchNotes         String?
  categorizedById    String?   @db.Uuid
  categorizedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account         BankReconciliationAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  costAllocations BankCostAllocation[]

  @@unique([organizationId, accountId, fingerprint])
  @@index([organizationId, status, transactionDate])
  @@index([organizationId, apartmentId, chargeRequired])
  @@index([organizationId, gridExpenseId])
  @@index([organizationId, linkedPaymentId])
  @@index([organizationId, transactionCategory, transactionDate])
  @@index([organizationId, internalTransferPairId])
}

model GridExpense {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entryId        String   @db.Uuid
  apartmentId    String   @db.Uuid // denormalised for search by unit (no FK)
  periodMonth    DateTime @db.Date

  // DB-ENFORCED: CHECK "GridExpense_bearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  bearer      String  @default("tenant") // "tenant" (cols O/P) | "owner" (cols Q/R)
  nature      String? // gridexpense-nature: per-row Expense/Profit routing. NULL/"expense" → tenant Expense Bill (EB-) / owner payout deduction (today's behavior, backward-compatible); "profit" → tenant IVTEN / owner IVOWN (KAEN revenue). Read ONLY when ENABLE_CHARGE_NATURE_ROUTING is ON (stamped onto Charge.nature by mintExpenseChargesTx); flag OFF ⇒ ignored.
  description String
  amount      Decimal @db.Decimal(12, 2)
  withSST     Boolean @default(false) // SST is COLUMN SEMANTICS, never an sstAmount number

  // Direct cost paid (or payable) by KAEN for fulfilling this charge. `amount`
  // remains the customer/owner-facing charge; these fields are internal cost
  // tracking and never change the amount billed.
  actualCost         Decimal?  @db.Decimal(12, 2)
  costVendor         String?
  costPaymentStatus  String    @default("unpaid") // "unpaid" | "partial" | "paid"
  costPaymentDate    DateTime? @db.Date
  costPaymentAccount String?
  costNotes          String?

  partyId String? @db.Uuid // party snapshot for tenant-record reachability + name/phone search

  chargeCategoryId String? @db.Uuid // bills-grid line classification (nullable; SetNull-safe — module never hard-deletes)

  tenancyId String? @db.Uuid // source tenancy snapshot (bill-expenses feature, spec R3) — drives tenant-invoice co-grouping at issuance

  status String @default("active") // "active" | "void" — the ONLY retire path in this module

  createdBy String   @db.Uuid // User.id — plain column (no FK)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry               UnitBillsGridEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  chargeCategory      ChargeCategory?      @relation(fields: [chargeCategoryId], references: [id], onDelete: SetNull)
  attachments         GridAttachment[]
  sourcedCharges      Charge[]             @relation("GridExpenseSourcedCharges")
  bankCostAllocations BankCostAllocation[]

  @@index([organizationId, entryId])
  @@index([organizationId, apartmentId, periodMonth])
  @@index([organizationId, partyId])
  @@index([organizationId, chargeCategoryId])
}

model GridMeterReading {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entryId        String   @db.Uuid
  apartmentId    String   @db.Uuid // denormalised (no FK)
  periodMonth    DateTime @db.Date

  listingId String  @db.Uuid // the ROOM. = Listing.id, mirroring MeterReading.unitId (meter/repository.ts:99).
  // NOT NULL: every reading belongs to a room, occupied or vacant. No FK (snapshot store,
  // consistent with the other grid columns). This is the per-room discriminator the unique
  // index keys on, so it BITES for vacant rooms (which legally carry readings — spec C1).
  tenancyId String? @db.Uuid // KEEP nullable — snapshot; null = vacant/whole-unit. Multiple NULLs per entry are EXPECTED (one per vacant room) and correct.
  partyId   String? @db.Uuid // KEEP nullable — snapshot.

  previousKwh Decimal? @db.Decimal(12, 2)
  currentKwh  Decimal? @db.Decimal(12, 2)
  amount      Decimal? @db.Decimal(12, 2) // per-room AIRCOND submeter charge, ADMIN-ENTERED in v1.
  // Fed to RoomInput.airconCharge (compute.ts:51). NOT the pax share of leftover TNB.
  // The grid stores no tariff/rate; server-side derivation is DEFERRED (Open Question).

  createdBy   String   @db.Uuid // User.id — plain column (no FK)
  updatedById String?  @db.Uuid // User.id — last admin editor of THIS reading; NULL = never (plain column, no FK)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        UnitBillsGridEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Keyed on listingId (NOT NULL) so it BITES for vacant rooms and the upsert typechecks.
  // tenancyId is a snapshot payload, never a key (this replaces the spec's tenancyId-keyed index; see CORRECTION 2).
  @@unique([organizationId, entryId, listingId])
  @@index([organizationId, entryId])
  @@index([organizationId, apartmentId, periodMonth])
}

model UnitBillsBearerConfig {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  apartmentId    String @db.Uuid

  /// SEEDED BY THE APP, NOT BY THESE COLUMN DEFAULTS. The five bearer columns below are
  /// written explicitly from the apartment's LISTING MODE — `bearerDefaultsFor`
  /// (apps/api/src/modules/bills-grid/bearer-defaults.ts), applied by BOTH
  /// resolveBearerConfig (create) and getBearerConfigService/toBearerConfigDto (read of a
  /// unit with no row). WHOLE starts cleaning/WiFi TENANT-borne; PARTITIONED starts them
  /// OWNER-borne; TNB/AIR are "recharged" (= Tenant) in both. The @default values here
  /// survive only as a last-resort fallback for a raw INSERT that bypasses the app, so do
  /// NOT read them as the real seed — change bearer-defaults.ts instead. No migration was
  /// needed for the switch: the seed moved into the app, the columns did not change.
  tnbPattern           String @default("recharged")
  airPattern           String @default("recharged")
  // DB-ENFORCED: CHECK "UnitBillsBearerConfig_cleaningBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  cleaningBearer       String @default("owner")
  // DB-ENFORCED: CHECK "UnitBillsBearerConfig_wifiBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  wifiBearer           String @default("owner")
  // DB-ENFORCED: CHECK "UnitBillsBearerConfig_maintenanceFeeBearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  maintenanceFeeBearer String @default("owner")

  /// charge-nature gate (2026-07-27) — the unit's DEFAULT Expense/Profit nature for its
  /// cleaning / wifi scalar, editable in the Unit setting drawer. This is step 3 of
  /// `resolveScalarNatures`' precedence (period-lock.ts): the FROZEN entry column wins, then
  /// the GOVERNING recurring revision, then this. NULL = the admin has never decided, which
  /// under ENABLE_CHARGE_NATURE_ROUTING makes the Bill fail closed (`nature_unresolved`)
  /// rather than silently defaulting the scalar to profit → an owner IVOWN receivable.
  /// Nullable + no default ON PURPOSE: a default here would re-create the very silent
  /// assumption the gate exists to remove.
  cleaningNature String? // "expense" | "profit"
  wifiNature     String? // "expense" | "profit"

  /// Recurring cleaning amount a unit STARTS with. 0 = disabled (the established
  /// sentinel — backfill-recurring-defs.ts reads `0/null ⇒ disabled`), i.e. no recurring
  /// cleaning until an admin sets one in the grid's Recurring editor.
  /// ⚠️ Was `@default(100)` until 2026-08-17. `getOrCreateEntry` seeds the month entry's
  /// `cleaning` from this column, so the default was not cosmetic — every never-configured
  /// unit froze a billable RM 100 onto its first period. Keep in lock-step with
  /// `DEFAULT_CLEANING_RECURRING_AMOUNT` (bills-grid/bearer-defaults.ts), which covers the
  /// read paths where no row exists yet.
  cleaningRecurringAmount Decimal @default(0) @db.Decimal(12, 2)

  isLocked Boolean   @default(false) // set-once + audited unlock
  lockedAt DateTime?
  lockedBy String?   @db.Uuid // User.id — plain column (no FK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // optimistic-concurrency token

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Cascade, NOT Restrict: this row is pure per-apartment configuration carrying no money, so it dies with its Apartment. Deliberate asymmetry vs `UnitBillsGridEntry.apartment` (Restrict, precedent `UnitUtilityBill.apartment` schema.prisma:2735).
  apartment    Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, apartmentId])
}

/// Recurring-charge DEFINITION — the stable per-apartment identity of a recurring fee
/// (kind CLEANING | WIFI | CUSTOM). Money/effective-dating lives on RecurringChargeRevision;
/// this row never changes financially. Archived (archivedAt), NEVER hard-deleted, once used.
/// organizationId/apartmentId are plain columns (app-scoped, no back-relation churn), mirroring
/// the module's `lockedBy String? // plain column (no FK)` precedent.
model RecurringChargeDefinition {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  apartmentId    String    @db.Uuid
  kind           String // "CLEANING" | "WIFI" | "CUSTOM"
  code           String // stable per (org, apartment) — e.g. "cleaning", "wifi", "custom-<slug>"
  name           String
  archivedAt     DateTime?
  createdBy      String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  revisions RecurringChargeRevision[]

  @@unique([organizationId, apartmentId, code])
  @@index([organizationId, apartmentId])
}

/// Immutable effective-dated REVISION of a definition. Editing amount/bearer/category creates a
/// NEW revision and closes the prior's effectiveToMonth; disabling creates an enabled:false
/// revision. Revisions of one definition NEVER overlap on [effectiveFromMonth, effectiveToMonth).
/// categoryId is a plain column (no FK relation) — the app validates it against the seeded set.
model RecurringChargeRevision {
  id                 String    @id @default(uuid()) @db.Uuid
  definitionId       String    @db.Uuid
  amount             Decimal   @db.Decimal(12, 2)
  // DB-ENFORCED: CHECK "RecurringChargeRevision_bearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  bearer             String // "owner" | "tenant"
  categoryId         String?   @db.Uuid // ChargeCategory.id (custom lines); null for CLEANING/WIFI (they route via cats)
  nature             String? // "expense" | "profit" — null = legacy (treated as profit)
  effectiveFromMonth DateTime  @db.Date // first-of-month, inclusive
  effectiveToMonth   DateTime? @db.Date // first-of-month, EXCLUSIVE; null = open-ended
  enabled            Boolean   @default(true)
  createdBy          String    @db.Uuid
  createdAt          DateTime  @default(now())

  definition RecurringChargeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId, effectiveFromMonth])
}

/// Per-period frozen SNAPSHOT of a CUSTOM recurring line on one grid entry (cleaning/wifi keep
/// their scalar entry fields, NOT this table). Copies every financially-meaningful field so it
/// survives rename/disable/archive of the definition. definitionId/revisionId + resolved* are
/// plain columns (defs are archived-not-deleted → never dangling). Billing mints one Charge per row.
model GridEntryRecurringLine {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  gridEntryId       String   @db.Uuid
  definitionId      String   @db.Uuid
  revisionId        String   @db.Uuid
  name              String
  amount            Decimal  @db.Decimal(12, 2)
  // DB-ENFORCED: CHECK "GridEntryRecurringLine_bearer_check" (owner|tenant), migration 20260727140000.
  // Vocabulary source: `bearer` (shared/schemas/bills-grid.ts)
  bearer            String // "owner" | "tenant"
  nature            String? // snapshot of the revision's nature at Bill time
  categoryId        String   @db.Uuid
  categoryCode      String
  categoryName      String
  categoryFamily    String
  resolvedPartyId   String   @db.Uuid // owner party (owner-borne) or tenant party (tenant-borne)
  resolvedTenancyId String?  @db.Uuid // tenant-borne only; null for owner-borne
  resolvedUnitId    String   @db.Uuid // listing id (room / owner listing) stamped on the Charge
  effectiveMonth    DateTime @db.Date
  kind              String // "CUSTOM"
  createdAt         DateTime @default(now())

  gridEntry      UnitBillsGridEntry @relation(fields: [gridEntryId], references: [id], onDelete: Cascade)
  sourcedCharges Charge[]           @relation("RecurringLineSourcedCharges")

  @@unique([gridEntryId, definitionId])
  @@index([organizationId, gridEntryId])
}

model GridAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  apartmentId    String   @db.Uuid // denormalised (no FK)
  periodMonth    DateTime @db.Date

  entryId String @db.Uuid // non-nullable: the upload get-or-creates the parent entry first

  expenseId String? @db.Uuid // per-line link (nullable; entry-level rows stay null)

  // Optional cell-level document scope. Existing unit/expense attachments keep
  // these null, so this is fully additive and does not reclassify old files.
  cellKey      String? // apartmentId for unit-grain cells; listingId for room-grain cells
  columnId     String? // bills-grid ColumnId snapshot
  documentKind String? // "invoice" | "receipt"

  storageKey  String
  filename    String
  contentType String
  sizeBytes   Int

  uploadedBy String   @db.Uuid // User.id — plain column (no FK)
  createdAt  DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        UnitBillsGridEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  expense      GridExpense?       @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([organizationId, apartmentId, periodMonth])
  @@index([organizationId, apartmentId, periodMonth, cellKey, columnId, documentKind])
  @@index([organizationId, expenseId])
  @@index([entryId])
}
